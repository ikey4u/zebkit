+// zebkit: the pictures of format "zebkit-raw" until they are taken.
+struct ZebkitRawScreenshots {
+  base::Lock lock;
+  int next = 0;
+  std::map<std::string, SkBitmap> kept;
+};
+
+ZebkitRawScreenshots& GetZebkitRawScreenshots() {
+  static base::NoDestructor<ZebkitRawScreenshots> screenshots;
+  return *screenshots;
+}
+
+std::optional<std::vector<uint8_t>> KeepBitmapForZebkit(
+    const SkBitmap& bitmap) {
+  ZebkitRawScreenshots& screenshots = GetZebkitRawScreenshots();
+  base::AutoLock hold(screenshots.lock);
+  const std::string key = base::NumberToString(++screenshots.next);
+  screenshots.kept[key] = bitmap;
+  return std::vector<uint8_t>(key.begin(), key.end());
+}
+
 std::variant<protocol::Response, BitmapEncoder>
 GetEncoder(const std::string& format, int quality, bool optimize_for_speed) {
   if (quality < 0 || quality > 100) {
     quality = kDefaultScreenshotQuality;
   }
+  if (format == "zebkit-raw") {
+    return base::BindRepeating(&KeepBitmapForZebkit);
+  }
 
   if (format == protocol::Page::CaptureScreenshot::FormatEnum::Png) {
     return base::BindRepeating(optimize_for_speed ? EncodeBitmapAsPngFast
@@ -1925,6 +1952,18 @@ void PageHandler::ScreencastFrameEncoded(
                              std::move(page_metadata), session_id_);
 }
 
+SkBitmap TakeZebkitRawScreenshot(const std::string& key) {
+  ZebkitRawScreenshots& screenshots = GetZebkitRawScreenshots();
+  base::AutoLock hold(screenshots.lock);
+  auto found = screenshots.kept.find(key);
+  if (found == screenshots.kept.end()) {
+    return SkBitmap();
+  }
+  SkBitmap bitmap = std::move(found->second);
+  screenshots.kept.erase(found);
+  return bitmap;
+}
