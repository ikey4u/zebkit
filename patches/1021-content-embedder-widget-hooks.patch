+
+#ifndef CONTENT_PUBLIC_BROWSER_EMBEDDER_WIDGET_HOOKS_H_
+#define CONTENT_PUBLIC_BROWSER_EMBEDDER_WIDGET_HOOKS_H_
+
+#include "content/common/content_export.h"
+
+namespace gfx {
+class Rect;
+}
+
+namespace ui {
+class Cursor;
+}
+
+namespace content {
+
+class RenderWidgetHost;
+class WebContents;
+
+// What a page's widgets ask of the window they are in, for an embedder that
+// draws them without one (off-screen rendering) and shows the result
+// itself. Called on the UI thread.
+struct EmbedderWidgetHooks {
+  // The cursor `widget` asks for changed.
+  void (*cursor_changed)(RenderWidgetHost* widget,
+                         const ui::Cursor& cursor) = nullptr;
+  // `contents` showed a popup widget (a <select>'s list, a date or colour
+  // picker), `popup`, at `bounds_in_screen` (DIPs).
+  void (*popup_shown)(WebContents* contents,
+                      RenderWidgetHost* popup,
+                      const gfx::Rect& bounds_in_screen) = nullptr;
+};
+
+CONTENT_EXPORT void SetEmbedderWidgetHooks(const EmbedderWidgetHooks& hooks);
+CONTENT_EXPORT const EmbedderWidgetHooks& GetEmbedderWidgetHooks();
+
+}  // namespace content
+
+#endif  // CONTENT_PUBLIC_BROWSER_EMBEDDER_WIDGET_HOOKS_H_
