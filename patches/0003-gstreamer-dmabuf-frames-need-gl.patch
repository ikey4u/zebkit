Build fix: VideoFrameGStreamer::getDMABuf() without GStreamer GL.

getDMABuf() uses MemoryType::DMABuf and the dmabuf allocator header, which
only exist when USE(GSTREAMER_GL) is on, but the function is built whenever
USE(GBM) is. With GBM on and GStreamer's GL integration off (our media
configuration) the file does not compile. Frames are never DMABufs in that
configuration, so the function returns null there. No size effect.

--- a/Source/WebCore/platform/graphics/gstreamer/VideoFrameGStreamer.cpp
+++ b/Source/WebCore/platform/graphics/gstreamer/VideoFrameGStreamer.cpp
@@ -818,6 +818,9 @@
 #if USE(GBM) && GST_CHECK_VERSION(1, 24, 0)
 RefPtr<DMABufBuffer> VideoFrameGStreamer::getDMABuf()
 {
+#if !USE(GSTREAMER_GL)
+    return nullptr;
+#else
     if (m_memoryType != MemoryType::DMABuf)
         return nullptr;
 
@@ -887,6 +890,7 @@
     });
 
     return dmabuf;
+#endif // !USE(GSTREAMER_GL)
 }
 #endif
 
