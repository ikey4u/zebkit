Port: allow <video> and <audio> elements without a media backend.

On the GLib ports ENABLE_VIDEO is tied to GStreamer, so a build without
GStreamer has no HTMLMediaElement, HTMLVideoElement, Audio or MediaError at
all. Scripts on many large sites use those names without checking and throw
(34 of the top 100 sites failed for this reason). WebCore already has a
null media player for the case where no engine is registered; this lets the
build reach it: with ENABLE_VIDEO_WITHOUT_MEDIA_BACKEND set, ENABLE_VIDEO no
longer requires USE_GSTREAMER. The elements then exist, canPlayType()
answers "", and play() rejects, which is what sites handle. Nothing plays.

--- a/Source/cmake/GStreamerDependencies.cmake
+++ b/Source/cmake/GStreamerDependencies.cmake
@@ -1,5 +1,9 @@
 WEBKIT_OPTION_DEPEND(ENABLE_SPEECH_SYNTHESIS USE_GSTREAMER)
-WEBKIT_OPTION_DEPEND(ENABLE_VIDEO USE_GSTREAMER)
+# zebkit: with ENABLE_VIDEO_WITHOUT_MEDIA_BACKEND the media elements are built
+# with no playback engine behind them (see patches/2002).
+if (NOT ENABLE_VIDEO_WITHOUT_MEDIA_BACKEND)
+    WEBKIT_OPTION_DEPEND(ENABLE_VIDEO USE_GSTREAMER)
+endif ()
 WEBKIT_OPTION_DEPEND(ENABLE_WEB_AUDIO USE_GSTREAMER)
 WEBKIT_OPTION_DEPEND(ENABLE_WEB_CODECS USE_GSTREAMER)
 WEBKIT_OPTION_DEPEND(USE_GSTREAMER_GL ENABLE_VIDEO)
--- a/Source/WebCore/platform/GStreamer.cmake
+++ b/Source/WebCore/platform/GStreamer.cmake
@@ -1,5 +1,10 @@
 include(CheckCXXSymbolExists)
 
+# zebkit: media elements can be enabled with no backend; then nothing below applies.
+if (NOT USE_GSTREAMER)
+    return ()
+endif ()
+
 if (ENABLE_VIDEO OR ENABLE_WEB_AUDIO)
     list(APPEND WebCore_LIBRARIES
         GLib::GioUnix
--- a/Tools/MiniBrowser/wpe/main.cpp
+++ b/Tools/MiniBrowser/wpe/main.cpp
@@ -44,7 +44,7 @@
 #include <atk/atk.h>
 #endif
 
-#if !USE_GSTREAMER_FULL && (ENABLE_WEB_AUDIO || ENABLE_VIDEO)
+#if USE_GSTREAMER && !USE_GSTREAMER_FULL && (ENABLE_WEB_AUDIO || ENABLE_VIDEO)
 IGNORE_WARNINGS_BEGIN("cast-align")
 #include <gst/gst.h>
 IGNORE_WARNINGS_END
@@ -741,7 +741,7 @@
     GOptionContext* context = g_option_context_new(nullptr);
     g_option_context_add_main_entries(context, commandLineOptions, nullptr);
 
-#if !USE_GSTREAMER_FULL && (ENABLE_WEB_AUDIO || ENABLE_VIDEO)
+#if USE_GSTREAMER && !USE_GSTREAMER_FULL && (ENABLE_WEB_AUDIO || ENABLE_VIDEO)
     g_option_context_add_group(context, gst_init_get_option_group());
 #endif
 
