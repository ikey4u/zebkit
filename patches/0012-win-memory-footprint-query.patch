index 3fcbe1c8f..f7c8e4df9 100644
--- a/Source/WTF/wtf/win/MemoryFootprintWin.cpp
+++ b/Source/WTF/wtf/win/MemoryFootprintWin.cpp
@@ -64,10 +64,13 @@ size_t memoryFootprint()
