+namespace {
+Shell::FileChooserHandler& FileChooserHandlerForEmbedder() {
+  static base::NoDestructor<Shell::FileChooserHandler> handler;
+  return *handler;
+}
+}  // namespace
+
+void Shell::SetFileChooserHandler(FileChooserHandler handler) {
+  FileChooserHandlerForEmbedder() = std::move(handler);
+}
