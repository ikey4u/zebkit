   return true;
 }
 
+// zebkit: lines, polygons and polylines: the points of their /L or
+// /Vertices, stroked in /C with the border's width and dashes; a polygon
+// closed, and filled with /IC when it has one.
+bool GeneratePathAP(CPDF_Document* doc,
+                    CPDF_Dictionary* annot_dict,
+                    const char* key,
+                    bool closed) {
+  RetainPtr<const CPDF_Array> points = annot_dict->GetArrayFor(key);
+  if (!points || points->size() < 4) {
+    return false;
+  }
+
+  float border_width = GetBorderWidth(annot_dict);
+  const bool is_stroke = border_width > 0;
+  RetainPtr<const CPDF_Array> interior_color = annot_dict->GetArrayFor("IC");
+  const bool is_fill = closed && interior_color && !interior_color->IsEmpty();
+  if (!is_stroke && !is_fill) {
+    return false;
+  }
+
+  fxcrt::ostringstream app_stream;
+  app_stream << "/" << kGSDictName << " gs ";
+  if (is_fill) {
+    app_stream << GetColorStringWithDefault(interior_color.Get(),
+                                            CFX_Color::MakeTransparent(),
+                                            PaintOperation::kFill);
+  }
+  app_stream << GetColorStringWithDefault(
+      annot_dict->GetArrayFor(pdfium::annotation::kC).Get(),
+      CFX_Color::MakeRGB(0.0f, 0.0f, 0.0f), PaintOperation::kStroke);
+  if (is_stroke) {
+    app_stream << border_width << " w ";
+    app_stream << GetDashPatternString(annot_dict);
+  }
+
+  // The rectangle covers the points, and the stroke around them.
+  CFX_FloatRect bounds(points->GetFloatAt(0), points->GetFloatAt(1),
+                       points->GetFloatAt(0), points->GetFloatAt(1));
+  for (size_t i = 0; i + 1 < points->size(); i += 2) {
+    const float x = points->GetFloatAt(i);
+    const float y = points->GetFloatAt(i + 1);
+    bounds.left = std::min(bounds.left, x);
+    bounds.right = std::max(bounds.right, x);
+    bounds.bottom = std::min(bounds.bottom, y);
+    bounds.top = std::max(bounds.top, y);
+    app_stream << x << " " << y << (i == 0 ? " m " : " l ");
+  }
+  if (closed) {
+    app_stream << "h ";
+  }
+  app_stream << GetPaintOperatorString(is_stroke, is_fill) << "\n";
+  bounds.Inflate(border_width / 2 + 1, border_width / 2 + 1);
+  annot_dict->SetRectFor(pdfium::annotation::kRect, bounds);
+
+  auto gs_dict = GenerateExtGStateDict(*annot_dict, "Normal");
+  auto resources_dict = GenerateResourcesDict(doc, std::move(gs_dict), nullptr);
+  GenerateAndSetAPDict(doc, annot_dict, &app_stream, std::move(resources_dict),
+                       false /*IsTextMarkupAnnotation*/);
+  return true;
+}
