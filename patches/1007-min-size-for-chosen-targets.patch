Size: compile chosen parts of the engine with -Oz.

The engine is compiled with -Os, which in clang is a size-conscious -O2.
-Oz goes further at some cost in speed. A GN argument,
zebkit_min_size_patterns, lists patterns of source directories whose
static libraries and source sets get -Oz
(//build/config/compiler:optimize_min_size) in place of the default
optimization; profiles/slim.gn names the code that is off the hot path.
Targets that choose their own optimization keep it.

A second argument, zebkit_speed_patterns, names hot code that keeps -Os
with LLVM's own inliner (optimize_size_default_inliner) when use_ml_inliner
would have a model trained for size decide what is inlined
(patches/1008-ml-size-inliner-for-linux.patch).

--- a/build/config/BUILDCONFIG.gn
+++ b/build/config/BUILDCONFIG.gn
@@ -172,6 +172,20 @@
                        current_os != "ios" && current_os != "watchos"
 }
 
+declare_args() {
+  # zebkit: patterns of source directories, such as "//net/*" for //net
+  # and everything under it, whose static libraries and source sets are
+  # compiled for the smallest code (-Oz) in place of the default
+  # optimization. For code off the hot path. A pattern is matched against
+  # the directory with a "/" after it, as filter_include matches strings.
+  zebkit_min_size_patterns = []
+
+  # zebkit: patterns, matched the same way, of directories on the hot path
+  # that keep -Os with LLVM's own inliner where use_ml_inliner would have
+  # the size model decide what is inlined.
+  zebkit_speed_patterns = []
+}
+
 assert(!(is_debug && is_official_build), "Can't do official debug builds")
 assert(!(current_os == "ios" && is_component_build),
        "Can't use component build on iOS")
@@ -620,6 +634,27 @@
         use_libcxx_modules = false
       }
 
+      if (zebkit_min_size_patterns != [] &&
+          filter_include(
+              [ get_label_info(":$target_name", "dir") + "/" ],
+              zebkit_min_size_patterns) != [] &&
+          filter_include(configs,
+                         [ "//build/config/compiler:default_optimization" ]) !=
+          []) {
+        configs -= [ "//build/config/compiler:default_optimization" ]
+        configs += [ "//build/config/compiler:optimize_min_size" ]
+      } else if (zebkit_speed_patterns != [] &&
+                 filter_include(
+                     [ get_label_info(":$target_name", "dir") + "/" ],
+                     zebkit_speed_patterns) != [] &&
+                 filter_include(
+                     configs,
+                     [ "//build/config/compiler:default_optimization" ]) !=
+                 []) {
+        configs -= [ "//build/config/compiler:default_optimization" ]
+        configs += [ "//build/config/compiler:optimize_size_default_inliner" ]
+      }
