-constinit thread_local const char* thread_name = kDefaultName;
+// No address in the TLS initializer: host threads may predate dlopen and
+// receive their TLS copy before the library applies packed relocations.
+constinit thread_local const char* thread_name = nullptr;
 }  // namespace
 
