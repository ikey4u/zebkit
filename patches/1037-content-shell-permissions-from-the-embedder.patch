+namespace {
+ShellPermissionManager::EmbedderDecision& EmbedderDecisionForShell() {
+  static base::NoDestructor<ShellPermissionManager::EmbedderDecision> decision;
+  return *decision;
+}
+
+std::optional<blink::mojom::PermissionStatus> EmbedderStatus(
+    PermissionType permission,
+    const GURL& requesting_origin) {
+  const ShellPermissionManager::EmbedderDecision& decision =
+      EmbedderDecisionForShell();
+  return decision ? decision.Run(permission, requesting_origin) : std::nullopt;
+}
+}  // namespace
+
+void ShellPermissionManager::SetEmbedderDecision(EmbedderDecision decision) {
+  EmbedderDecisionForShell() = std::move(decision);
+}
