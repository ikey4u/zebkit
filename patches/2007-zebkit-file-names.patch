zebkit: name the shipped files after zebkit

What an application ships and links against carried the names of the WPE
port, so a zebkit package looked like, and could be mistaken for, a system
WPE WebKit. This renames the files, and nothing else:

    libWPEWebKit-2.0.so.1      ->  libzebkit.so.1   (file name and SONAME)
    WPEWebProcess              ->  zebkit-web
    WPENetworkProcess          ->  zebkit-network
    libWPEInjectedBundle.so    ->  libzebkit-bundle.so

The library looks its helpers up by these names, so the code that does is
changed with them. The API (WebKitWebView and the rest), the symbols, the
build targets and the pkg-config module names (wpe-webkit-2.0) are as they
were; the pkg-config files now say -lzebkit.

--- a/Source/WebKit/PlatformWPE.cmake
+++ b/Source/WebKit/PlatformWPE.cmake
@@ -12,10 +12,11 @@
     include(PdfJSGResources.cmake)
 endif ()
 
-set(WebKit_OUTPUT_NAME WPEWebKit-${WPE_API_VERSION})
-set(WebProcess_OUTPUT_NAME WPEWebProcess)
-set(NetworkProcess_OUTPUT_NAME WPENetworkProcess)
-set(GPUProcess_OUTPUT_NAME WPEGPUProcess)
+# zebkit: the files an application ships are named after zebkit.
+set(WebKit_OUTPUT_NAME zebkit)
+set(WebProcess_OUTPUT_NAME zebkit-web)
+set(NetworkProcess_OUTPUT_NAME zebkit-network)
+set(GPUProcess_OUTPUT_NAME zebkit-gpu)
 
 file(MAKE_DIRECTORY ${DERIVED_SOURCES_WPE_API_DIR})
 file(MAKE_DIRECTORY ${FORWARDING_HEADERS_WPE_DIR})
@@ -602,6 +603,7 @@
 add_library(WPEInjectedBundle MODULE "${WEBKIT_DIR}/WebProcess/InjectedBundle/API/glib/WebKitInjectedBundleMain.cpp")
 WEBKIT_ADD_PREFIX_HEADER(WPEInjectedBundle WebKitPrefix.h PREFIX_LANGUAGES CXX)
 target_link_libraries(WPEInjectedBundle WebKit)
+set_target_properties(WPEInjectedBundle PROPERTIES OUTPUT_NAME zebkit-bundle)
 
 target_include_directories(WPEInjectedBundle PRIVATE $<TARGET_PROPERTY:WebKit,INCLUDE_DIRECTORIES>)
 
