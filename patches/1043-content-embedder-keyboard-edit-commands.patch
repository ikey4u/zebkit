 };
 
+// Editing commands resolved by the host's native key bindings (AppKit).
+struct EmbedderEditCommand {
+  std::string name;
+  std::string value;
+};
+CONTENT_EXPORT void ForwardEmbedderKeyboardEventWithCommands(
+    RenderWidgetHost* widget,
+    const input::NativeWebKeyboardEvent& event,
+    const std::vector<EmbedderEditCommand>& commands);
+
 CONTENT_EXPORT void SetEmbedderWidgetHooks(const EmbedderWidgetHooks& hooks);
 CONTENT_EXPORT const EmbedderWidgetHooks& GetEmbedderWidgetHooks();
 
--- a/content/browser/renderer_host/render_widget_host_impl.cc
+++ b/content/browser/renderer_host/render_widget_host_impl.cc
@@ -4565,6 +4565,17 @@
 EmbedderWidgetHooks g_embedder_widget_hooks;
 }  // namespace
 
+void ForwardEmbedderKeyboardEventWithCommands(
+    RenderWidgetHost* widget,
+    const input::NativeWebKeyboardEvent& event,
+    const std::vector<EmbedderEditCommand>& commands) {
+  std::vector<blink::mojom::EditCommandPtr> native;
+  for (const auto& command : commands)
+    native.push_back(blink::mojom::EditCommand::New(command.name, command.value));
+  static_cast<RenderWidgetHostImpl*>(widget)->ForwardKeyboardEventWithCommands(
+      event, ui::LatencyInfo(), std::move(native));
+}
+
 void SetEmbedderWidgetHooks(const EmbedderWidgetHooks& hooks) {
   g_embedder_widget_hooks = hooks;
 }
