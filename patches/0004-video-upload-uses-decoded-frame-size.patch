Bug fix: software video upload read past the end of the frame.

Without GStreamer GL, decoded frames are mapped and uploaded to a texture.
The upload used the frame's presentation size for both the texture and the
number of pixels read, but read them from the decoded buffer, whose size is
the coded size. For video whose two sizes differ (non-square pixels, crop)
the GL driver read beyond the buffer and the web process crashed with
SIGSEGV; ikea.com did this on about half its loads. Upload the decoded size
instead, and skip frames whose first plane is not a 4-byte-per-pixel layout.
The layer still presents at its own size.

--- a/Source/WebCore/platform/graphics/texmap/coordinated/CoordinatedPlatformLayerBufferVideo.cpp
+++ b/Source/WebCore/platform/graphics/texmap/coordinated/CoordinatedPlatformLayerBufferVideo.cpp
@@ -281,7 +281,15 @@
     OptionSet<BitmapTexture::Flags> textureFlags = { BitmapTexture::Flags::UseBGRALayout };
     if (GST_VIDEO_INFO_HAS_ALPHA(m_mappedVideoFrame->info()))
         textureFlags.add(BitmapTexture::Flags::SupportsAlpha);
-    auto texture = BitmapTexturePool::singleton().acquireTexture(m_size, textureFlags);
+    // Upload exactly what was decoded. m_size is the presentation size, which
+    // differs from the frame's own size for anamorphic or cropped video;
+    // reading m_size worth of pixels from the frame then runs off its end.
+    IntSize frameSize(m_mappedVideoFrame->width(), m_mappedVideoFrame->height());
+    if (frameSize.isEmpty() || m_mappedVideoFrame->planeStride(0) < frameSize.width() * 4) {
+        m_mappedVideoFrame = std::nullopt;
+        return;
+    }
+    auto texture = BitmapTexturePool::singleton().acquireTexture(frameSize, textureFlags);
 
     auto* meta = gst_buffer_get_video_gl_texture_upload_meta(m_mappedVideoFrame->get()->buffer);
     if (meta && meta->n_textures == 1) {
@@ -295,7 +303,7 @@
     int stride = m_mappedVideoFrame->planeStride(0);
     auto srcData = m_mappedVideoFrame->planeData(0);
     IntPoint origin;
-    texture->updateContents(srcData.data(), IntRect(origin, m_size), origin, stride, PixelFormat::BGRA8);
+    texture->updateContents(srcData.data(), IntRect(origin, frameSize), origin, stride, PixelFormat::BGRA8);
     m_buffer = CoordinatedPlatformLayerBufferRGB::create(WTF::move(texture), m_flags, nullptr);
     m_mappedVideoFrame = std::nullopt;
 }
