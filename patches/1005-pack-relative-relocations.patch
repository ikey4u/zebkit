--- /dev/null
+++ b/zebkit/relr/zebkit_relr.lds
@@ -0,0 +1,6 @@
+/* The packed relocations go after the PLT's. The loader of glibc 2.17
+   processes .rela.dyn and .rela.plt as one table when the program is
+   bound at load time, and assumes the one follows the other; lld puts
+   .relr.dyn between them. The link step recognizes this file's name and
+   renames the DT_RELR tags (relr_tags.py). */
+SECTIONS { .relr.dyn : { *(.relr.dyn) } } INSERT AFTER .rela.plt;
