--- /dev/null
+++ b/zebkit/relr/relr_preinit.c
@@ -0,0 +1,161 @@
+// Applies the binary's packed relative relocations (DT_RELR) itself, so
+// that they work with every glibc: only 2.36 and later know the format.
+//
+// The engine is linked with --pack-dyn-relocs=relr, which stores its 270
+// thousand relative relocations in about 100 KiB instead of 6.2 MiB. The
+// link step then renames the DT_RELR tags (relr_tags.py) so that no loader
+// applies them, or refuses the binary for want of the GLIBC_ABI_DT_RELR
+// version, which older glibc does not have.
+//
+// In an executable this runs first among the binary's code: from
+// .preinit_array, which the loader calls after relocating and before any
+// library constructor. Those constructors can call into the engine, which
+// provides malloc. In a shared library (ZEBKIT_RELR_SHARED) it is the
+// library's DT_INIT function (the link gives -init): the loader calls that
+// at the library's address plus DT_INIT, which needs no relocation, and
+// before it reads .init_array, whose entries are relocations in the packed
+// table themselves. The libraries it depends on were initialized before it
+// and do not call into it. Until it is done, nothing it touches may need
+// relocating: it reads only its own ELF headers, found at addresses
+// relative to the code.
+
+#include <elf.h>
+#include <link.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <sys/mman.h>
+#include <sys/syscall.h>
+
+// The renamed tags; relr_tags.py writes them.
+#define ZEBKIT_DT_RELR 0x6fffe000
+#define ZEBKIT_DT_RELRSZ 0x6fffe001
+
+extern const ElfW(Ehdr) __ehdr_start __attribute__((visibility("hidden")));
+extern ElfW(Dyn) _DYNAMIC[] __attribute__((visibility("hidden")));
+
+// A pointer in the thread-local data, relocated like any other, that says
+// whether the main thread's copy of that data was fixed as well.
+static const char tls_target = 0;
+#if defined(ZEBKIT_RELR_SHARED)
+// Not static, so that its name is the one the assembly below gives.
+__attribute__((visibility("hidden")))
+__thread const char* volatile zebkit_relr_tls_check = &tls_target;
+#define tls_check zebkit_relr_tls_check
+#else
+static __thread const char* volatile tls_check = &tls_target;
+#endif
+
+// The pages wholly inside [start, end), as the loader protects them. A raw
+// system call: libc's wrapper may be instrumented.
+static long raw_mprotect(uintptr_t start, uintptr_t end, int prot) {
+  long ret;
+  start &= ~(uintptr_t)4095;
+  end &= ~(uintptr_t)4095;
+  __asm__ volatile("syscall"
+                   : "=a"(ret)
+                   : "a"(SYS_mprotect), "D"(start), "S"(end - start), "d"(prot)
+                   : "rcx", "r11", "memory");
+  return ret;
+}
+
+static void relocate(uintptr_t* where, uintptr_t base, uintptr_t tls_start,
+                     uintptr_t tls_end, uintptr_t tls_block) {
+  *where += base;
+  // The loader copied the thread-local data for the main thread before this
+  // runs; that copy needs the same fix.
+  uintptr_t at = (uintptr_t)where;
+  if (at >= tls_start && at < tls_end)
+    *(uintptr_t*)(tls_block + (at - tls_start)) += base;
+}
+
+__attribute__((no_stack_protector, no_sanitize("all"))) static void
+apply_relr(int argc, char** argv, char** envp) {
+  (void)argc, (void)argv, (void)envp;
+  const uintptr_t base = (uintptr_t)&__ehdr_start;
+  const uintptr_t* relr = NULL;
+  size_t relrsz = 0;
+  for (const ElfW(Dyn)* d = _DYNAMIC; d->d_tag != DT_NULL; ++d) {
+    if (d->d_tag == ZEBKIT_DT_RELR)
+      relr = (const uintptr_t*)(base + d->d_un.d_ptr);
+    else if (d->d_tag == ZEBKIT_DT_RELRSZ)
+      relrsz = d->d_un.d_val;
+  }
+  if (!relr)
+    __builtin_trap();  // Linked without relr_tags.py.
+
+  uintptr_t relro_start = 0, relro_end = 0;
+  uintptr_t tls_start = 0, tls_end = 0, tls_block = 0;
+  const ElfW(Phdr)* ph = (const ElfW(Phdr)*)(base + __ehdr_start.e_phoff);
+  for (int i = 0; i < __ehdr_start.e_phnum; ++i) {
+    if (ph[i].p_type == PT_GNU_RELRO) {
+      relro_start = base + ph[i].p_vaddr;
+      relro_end = relro_start + ph[i].p_memsz;
+    } else if (ph[i].p_type == PT_TLS) {
+      tls_start = base + ph[i].p_vaddr;
+      tls_end = tls_start + ph[i].p_filesz;
+#if defined(ZEBKIT_RELR_SHARED)
+      // A library's block is wherever the loader put it, and the loader
+      // has copied the data into it for the threads that exist, from the
+      // image not yet relocated here. This thread's block is the address
+      // of one of the library's thread-local variables less that
+      // variable's offset in the block, which the link fixed. A thread that
+      // existed before a dlopen() of the library keeps its stale copy:
+      // linking the library, or loading it before starting threads, is
+      // what is supported.
+      uintptr_t offset;
+      __asm__("movabsq $zebkit_relr_tls_check@dtpoff, %0" : "=r"(offset));
+      tls_block = (uintptr_t)&tls_check - offset;
+#else
+      // On x86-64 the executable's block ends at the thread pointer.
+      uintptr_t align = ph[i].p_align ? ph[i].p_align : 1;
+      uintptr_t size = (ph[i].p_memsz + align - 1) & ~(align - 1);
+      uintptr_t tp;
+      __asm__("mov %%fs:0, %0" : "=r"(tp));
+      tls_block = tp - size;
+#endif
+    }
+  }
+  if (relro_start &&
+      raw_mprotect(relro_start, relro_end, PROT_READ | PROT_WRITE)) {
+    __builtin_trap();
+  }
+
+  // An even entry is the address of a relocation; an odd one is a bitmap
+  // of which of the 63 words after the last address are relocations.
+  uintptr_t* where = NULL;
+  for (size_t i = 0; i < relrsz / sizeof(uintptr_t); ++i) {
+    uintptr_t entry = relr[i];
+    if ((entry & 1) == 0) {
+      where = (uintptr_t*)(base + entry);
+      relocate(where++, base, tls_start, tls_end, tls_block);
+    } else {
+      for (uintptr_t* p = where; (entry >>= 1) != 0; ++p) {
+        if (entry & 1)
+          relocate(p, base, tls_start, tls_end, tls_block);
+      }
+      where += 8 * sizeof(uintptr_t) - 1;
+    }
+  }
+
+  if (relro_start && raw_mprotect(relro_start, relro_end, PROT_READ))
+    __builtin_trap();
+  if (tls_check != &tls_target)
+    __builtin_trap();
+}
+
+#if defined(ZEBKIT_RELR_SHARED)
+// DT_INIT, by name for the link's -init. A direct call, which needs no
+// relocation.
+void zebkit_relr_init(int argc, char** argv, char** envp);
+__attribute__((visibility("hidden"), used, no_stack_protector,
+               no_sanitize("all"))) void
+zebkit_relr_init(int argc, char** argv, char** envp) {
+  apply_relr(argc, argv, envp);
+}
+#else
+// Byte-aligned, so that the linker leaves this one relocation out of the
+// packed table: the loader applies it before calling the function.
+static const struct __attribute__((packed)) {
+  void (*function)(int, char**, char**);
+} preinit __attribute__((used, section(".preinit_array"))) = {apply_relr};
+#endif
