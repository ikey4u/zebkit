+# Packed relative relocations for an executable or a shared library on any
+# glibc: see relr_preinit.c. An executable gets them by depending on :relr.
+
+import("//zebkit/relr/relr.gni")
+
+assert(zebkit_pack_relocations)
+
+config("link") {
+  _script = "zebkit_relr.lds"
+  ldflags = [
+    "-Wl,--pack-dyn-relocs=relr",
+    "-Wl,-T," + rebase_path(_script, root_build_dir),
+  ]
+  inputs = [
+    _script,
+    "relr_tags.py",
+  ]
+}
+
+source_set("relr") {
+  sources = [ "relr_preinit.c" ]
+  all_dependent_configs = [ ":link" ]
+}
+
+# A shared library runs the function as its DT_INIT.
+config("link_shared") {
+  ldflags = [ "-Wl,-init,zebkit_relr_init" ]
+}
+
+# The same for a shared library, which depends on this one and adds the
+# configs :link and :link_shared to its own: as all_dependent_configs they
+# would reach the programs linked against the library too, which do not
+# apply packed relocations.
+source_set("relr_shared") {
+  sources = [ "relr_preinit.c" ]
+  defines = [ "ZEBKIT_RELR_SHARED" ]
+}
