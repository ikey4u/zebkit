+#!/usr/bin/env python3
+"""Rename an ELF file's DT_RELR tags so that no loader applies them.
+
+For a binary that applies its packed relocations itself (relr_preinit.c).
+glibc 2.36 and later would apply them a second time, and refuses a DT_RELR
+without the GLIBC_ABI_DT_RELR version, which older glibc does not have. The
+file is changed in place; renaming a file twice changes nothing.
+
+    relr_tags.py <file>
+"""
+
+import struct
+import sys
+
+DT_RELRSZ, DT_RELR, DT_RELRENT = 35, 36, 37
+# What relr_preinit.c looks for. Tags in this range are the operating
+# system's to define; glibc ignores the ones it does not know.
+RENAMED = {DT_RELR: 0x6FFFE000, DT_RELRSZ: 0x6FFFE001, DT_RELRENT: 0x6FFFE002}
+PT_DYNAMIC = 2
+
+
+def rename(path):
+  with open(path, "r+b") as f:
+    data = bytearray(f.read())
+    if data[:4] != b"\x7fELF" or data[4] != 2 or data[5] != 1:
+      raise ValueError(f"{path}: not a little-endian 64-bit ELF file")
+    phoff, = struct.unpack_from("<Q", data, 0x20)
+    phentsize, phnum = struct.unpack_from("<HH", data, 0x36)
+    for i in range(phnum):
+      p_type, _, p_offset, _, _, p_filesz = struct.unpack_from(
+          "<IIQQQQ", data, phoff + i * phentsize)
+      if p_type == PT_DYNAMIC:
+        break
+    else:
+      raise ValueError(f"{path}: no dynamic section")
+    for at in range(p_offset, p_offset + p_filesz, 16):
+      tag, = struct.unpack_from("<q", data, at)
+      if tag == 0:
+        break
+      if tag in RENAMED:
+        f.seek(at)
+        f.write(struct.pack("<q", RENAMED[tag]))
+
+
+if __name__ == "__main__":
+  rename(sys.argv[1])

