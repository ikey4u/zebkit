   return value;
 }
-PermissionOverrides::PermissionOverrides() : reset_revision_(NextRevision()) {}
+PermissionOverrides::PermissionOverrides() = default;
 
 PermissionOverrides::~PermissionOverrides() = default;
 PermissionOverrides::PermissionOverrides(PermissionOverrides&& other) = default;
@@ -134,7 +134,7 @@
 uint64_t PermissionOverrides::GetRevision(const url::Origin& requesting,
     const url::Origin& embedding, blink::PermissionType type) const {
