Recheck certificate errors on pooled TLS connections before sending HTTP.

A certificate accepted by one request must not bypass the next request's
embedder decision. Reuse the transaction's existing bad-certificate records,
report the original SSLInfo, and preserve explicit global ignore settings.

--- a/net/http/http_network_transaction.cc
+++ b/net/http/http_network_transaction.cc
@@ -4,6 +4,7 @@
 
 #include "net/http/http_network_transaction.h"
 
+#include <algorithm>
 #include <deque>
 #include <optional>
 #include <queue>
@@ -49,6 +50,7 @@
 #include "net/base/upload_data_stream.h"
 #include "net/base/url_util.h"
 #include "net/cert/cert_status_flags.h"
+#include "net/cert/x509_certificate.h"
 #include "net/filter/filter_source_stream.h"
 #include "net/filter/source_stream_type.h"
 #include "net/http/bidirectional_stream_impl.h"
@@ -1222,6 +1224,27 @@
     return HandleIOError(result);
   }
 
+  SSLInfo ssl_info;
+  if (IsSecureRequest()) {
+    stream_->GetSSLInfo(&ssl_info);
+    if (IsCertStatusError(ssl_info.cert_status) &&
+        !session_->params().ignore_certificate_errors &&
+        !std::ranges::any_of(observed_bad_certs_, [&](const auto& allowed) {
+          return allowed.cert_status == ssl_info.cert_status &&
+                 ssl_info.cert->EqualsExcludingChain(allowed.cert.get());
+        })) {
+      // A pooled TLS connection may have been accepted by another request.
+      // Ask this transaction's caller before sending any HTTP headers or body,
+      // just as for a newly established connection with a certificate error.
+      response_.ssl_info = ssl_info;
+      observed_bad_certs_.emplace_back(ssl_info.cert, ssl_info.cert_status);
+      stream_->Close(/*not_reusable=*/false);
+      stream_.reset();
+      next_state_ = STATE_NONE;
+      return MapCertStatusToNetError(ssl_info.cert_status);
+    }
+  }
+
   if (connected_callback_.is_null()) {
     return OK;
   }
