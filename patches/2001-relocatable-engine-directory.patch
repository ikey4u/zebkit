 }
--- a/Source/WebKit/Shared/glib/ProcessExecutablePathGLib.cpp
+++ b/Source/WebKit/Shared/glib/ProcessExecutablePathGLib.cpp
@@ -30,8 +30,51 @@
 #include <glib.h>
 #include <wtf/FileSystem.h>
 
+#if defined(ZEBKIT_RELOCATABLE)
+#include <dlfcn.h>
+#include <wtf/NeverDestroyed.h>
+#include <wtf/glib/GUniquePtr.h>
+#endif
+
 namespace WebKit {
 
+#if defined(ZEBKIT_RELOCATABLE)
+String engineLibraryDirectory()
+{
+    static NeverDestroyed<String> directory = [] {
+        Dl_info info;
+        if (!dladdr(reinterpret_cast<void*>(&engineLibraryDirectory), &info) || !info.dli_fname)
+            return String();
+        GUniquePtr<char> resolved(realpath(info.dli_fname, nullptr));
+        if (!resolved)
+            return String();
+        return FileSystem::parentPath(FileSystem::stringFromFileSystemRepresentation(resolved.get()));
+    }();
+    return directory;
+}
+
+// Runs when the library is loaded, in every process, before GIO looks for
+// its TLS backend.
+__attribute__((constructor)) static void addBundledGIOModules()
+{
+    Dl_info info;
+    if (!dladdr(reinterpret_cast<void*>(&addBundledGIOModules), &info) || !info.dli_fname)
+        return;
+    GUniquePtr<char> resolved(realpath(info.dli_fname, nullptr));
+    if (!resolved)
+        return;
+    GUniquePtr<char> engineDirectory(g_path_get_dirname(resolved.get()));
+    GUniquePtr<char> modules(g_build_filename(engineDirectory.get(), "gio", "modules", nullptr));
+    if (!g_file_test(modules.get(), G_FILE_TEST_IS_DIR))
+        return;
+    const char* existing = g_getenv("GIO_EXTRA_MODULES");
+    GUniquePtr<char> value(existing && *existing
+        ? g_strconcat(modules.get(), G_SEARCHPATH_SEPARATOR_S, existing, nullptr)
+        : g_strdup(modules.get()));
+    g_setenv("GIO_EXTRA_MODULES", value.get(), TRUE);
+}
+#endif
+
