zebkit: shut EGL down before the display connection it runs on is closed

A WPEDisplay subclass closes its connection to the display server in its
dispose function (wl_display_disconnect on Wayland), and then chains up to
WPEDisplay's, which calls eglTerminate. The EGL display was created on that
connection, so the driver cleans up through a connection that has been
freed. With Mesa on Wayland this crashes: an application that has shown a
window dies with SIGSEGV when it exits normally, in the exit handler that
releases the display.

WPEDisplay now has wpeDisplayTerminateEGL(), and the Wayland and X11
backends call it first in their dispose functions. Applied after the X11
backend's patch, which it also touches.

--- a/Source/WebKit/WPEPlatform/wpe/WPEDisplay.cpp
+++ b/Source/WebKit/WPEPlatform/wpe/WPEDisplay.cpp
@@ -130,14 +130,23 @@
     G_OBJECT_CLASS(wpe_display_parent_class)->constructed(object);
 }
 
-static void wpeDisplayDispose(GObject* object)
+// zebkit: the EGL display is made on top of the connection to the display
+// server, which belongs to the subclass. A subclass's dispose runs before
+// this class's, so one that closes the connection calls this first; EGL
+// would otherwise be shut down through a connection that is gone, and the
+// process would crash on its way out.
+void wpeDisplayTerminateEGL(WPEDisplay* display)
 {
-    auto* priv = WPE_DISPLAY(object)->priv;
-
+    auto* priv = display->priv;
     if (priv->eglDisplay) {
         eglTerminate(priv->eglDisplay);
         priv->eglDisplay = nullptr;
     }
+}
+
+static void wpeDisplayDispose(GObject* object)
+{
+    wpeDisplayTerminateEGL(WPE_DISPLAY(object));
 
     G_OBJECT_CLASS(wpe_display_parent_class)->dispose(object);
 }
--- a/Source/WebKit/WPEPlatform/wpe/WPEDisplayPrivate.h
+++ b/Source/WebKit/WPEPlatform/wpe/WPEDisplayPrivate.h
@@ -30,4 +30,5 @@
 
 WPEView* wpeDisplayCreateView(WPEDisplay*);
 bool wpeDisplayCheckEGLExtension(WPEDisplay*, const char*);
+void wpeDisplayTerminateEGL(WPEDisplay*);
 WPEInputMethodContext* wpeDisplayCreateInputMethodContext(WPEDisplay*, WPEView*);
--- a/Source/WebKit/WPEPlatform/wpe/wayland/WPEDisplayWayland.cpp
+++ b/Source/WebKit/WPEPlatform/wpe/wayland/WPEDisplayWayland.cpp
@@ -28,6 +28,7 @@
 
