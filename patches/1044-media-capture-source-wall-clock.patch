+void ChunkDemuxer::SetTimelineOffsetForCapture(base::Time origin,
+                                               base::TimeDelta from) {
+  base::AutoLock auto_lock(lock_);
+  if (state_ == SHUTDOWN || origin.is_null()) return;
+  capture_timeline_offset_ = origin;
+  auto after = capture_timeline_offsets_.upper_bound(from);
+  if (after != capture_timeline_offsets_.begin() && std::prev(after)->second == origin)
+    return;
+  capture_timeline_offsets_[from] = origin;
+  // Live buffers retain a bounded recent window. Already active taps keep
+  // their own complete history; never extrapolate an evicted old anchor.
+  if (capture_timeline_offsets_.size() > 4096)
+    capture_timeline_offsets_.erase(capture_timeline_offsets_.begin());
+  if (tap_) tap_->OnTimelineOffset(origin, from);
+}
