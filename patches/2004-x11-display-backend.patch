+++ b/Source/WebKit/WPEPlatform/wpe/x11/WPEPlatformX11.h
@@ -0,0 +1,36 @@
+/*
+ * zebkit: an X11 implementation of the WPE platform API.
+ *
+ * Upstream WPE draws through Wayland, DRM or nothing (headless). This adds a
+ * plain X11 backend for systems that have an X server but no Wayland
+ * compositor. It is deliberately simple: one X window per toplevel, frames
+ * copied into it with XPutImage, and core-protocol input events. It needs
+ * nothing beyond libX11, which the engine loads on demand, so the backend
+ * simply declines to connect where there is no X.
+ *
+ * It is registered below Wayland and above headless: wpe_display_get_default()
+ * tries Wayland first, then X11, then renders offscreen.
+ */
+
+#ifndef WPEPlatformX11_h
+#define WPEPlatformX11_h
+
+#include <glib-object.h>
+#include <wpe/wpe-platform.h>
+
+G_BEGIN_DECLS
+
+#define WPE_TYPE_DISPLAY_X11 (wpe_display_x11_get_type())
+WPE_API G_DECLARE_FINAL_TYPE (WPEDisplayX11, wpe_display_x11, WPE, DISPLAY_X11, WPEDisplay)
+
+#define WPE_TYPE_TOPLEVEL_X11 (wpe_toplevel_x11_get_type())
+WPE_API G_DECLARE_FINAL_TYPE (WPEToplevelX11, wpe_toplevel_x11, WPE, TOPLEVEL_X11, WPEToplevel)
+
+#define WPE_TYPE_VIEW_X11 (wpe_view_x11_get_type())
+WPE_API G_DECLARE_FINAL_TYPE (WPEViewX11, wpe_view_x11, WPE, VIEW_X11, WPEView)
+
+WPE_API WPEDisplay *wpe_display_x11_new (void);
+
+G_END_DECLS
+
+#endif /* WPEPlatformX11_h */
