+/*
+ * zebkit: an X11 implementation of the WPE platform API. See WPEPlatformX11.h.
+ */
+
+#include "config.h"
+#include "WPEPlatformX11.h"
+
+#include "WPEBufferSHM.h"
+#include "WPEExtensions.h"
+#include <X11/Xatom.h>
+#include <X11/Xlib.h>
+#include <X11/Xutil.h>
+#include <wtf/glib/GRefPtr.h>
+#include <wtf/glib/GUniquePtr.h>
+#include <wtf/glib/RunLoopSourcePriority.h>
+#include <wtf/glib/WTFGType.h>
+
+// Xlib.h defines these as macros; they collide with WebKit and GLib names.
+#undef None
+#undef Status
+#undef Bool
+#undef Success
+#undef Always
+
+static const long xNone = 0L;
+
+// ---------------------------------------------------------------- display --
+
+struct _WPEDisplayX11Private {
+    Display* xdisplay;
+    GRefPtr<GSource> eventSource;
+    GPollFD pollFD;
+    Atom wmProtocols;
+    Atom wmDeleteWindow;
+    Atom netWMName;
+    Atom utf8String;
+    Atom netWMState;
+    Atom netWMStateFullscreen;
+    Atom netWMStateMaximizedVert;
+    Atom netWMStateMaximizedHorz;
+    // Window to toplevel, for routing events.
+    GHashTable* toplevels;
+};
+
+WEBKIT_DEFINE_FINAL_TYPE_WITH_CODE(WPEDisplayX11, wpe_display_x11, WPE_TYPE_DISPLAY, WPEDisplay,
+    wpeEnsureExtensionPointsRegistered();
+    g_io_extension_point_implement(WPE_DISPLAY_EXTENSION_POINT_NAME, g_define_type_id, "x11", -50))
+
+struct _WPEToplevelX11Private {
+    Window window;
+    GC gc;
+    int pointerX;
+    int pointerY;
+    bool hasPointerPosition;
+};
+
+WEBKIT_DEFINE_FINAL_TYPE(WPEToplevelX11, wpe_toplevel_x11, WPE_TYPE_TOPLEVEL, WPEToplevel)
+
+struct _WPEViewX11Private {
+    GRefPtr<WPEBuffer> pendingBuffer;
+    GRefPtr<WPEBuffer> committedBuffer;
+    GRefPtr<GSource> frameSource;
+    gint64 lastFrameTime;
+};
+
+WEBKIT_DEFINE_FINAL_TYPE(WPEViewX11, wpe_view_x11, WPE_TYPE_VIEW, WPEView)
+
+static Display* xDisplayOf(WPEDisplay* display)
+{
+    return WPE_DISPLAY_X11(display)->priv->xdisplay;
+}
+
+static WPEView* firstView(WPEToplevel* toplevel)
+{
+    WPEView* found = nullptr;
+    wpe_toplevel_foreach_view(toplevel, [](WPEToplevel*, WPEView* view, gpointer data) -> gboolean {
+        *static_cast<WPEView**>(data) = view;
+        return TRUE;
+    }, &found);
+    return found;
+}
+
+static WPEModifiers modifiersFromState(unsigned state)
+{
+    unsigned modifiers = 0;
+    if (state & ControlMask)
+        modifiers |= WPE_MODIFIER_KEYBOARD_CONTROL;
+    if (state & ShiftMask)
+        modifiers |= WPE_MODIFIER_KEYBOARD_SHIFT;
+    if (state & Mod1Mask)
+        modifiers |= WPE_MODIFIER_KEYBOARD_ALT;
+    if (state & Mod4Mask)
+        modifiers |= WPE_MODIFIER_KEYBOARD_META;
+    if (state & LockMask)
+        modifiers |= WPE_MODIFIER_KEYBOARD_CAPS_LOCK;
+    if (state & Button1Mask)
+        modifiers |= WPE_MODIFIER_POINTER_BUTTON1;
+    if (state & Button2Mask)
+        modifiers |= WPE_MODIFIER_POINTER_BUTTON2;
+    if (state & Button3Mask)
+        modifiers |= WPE_MODIFIER_POINTER_BUTTON3;
+    return static_cast<WPEModifiers>(modifiers);
+}
+
+static void sendEvent(WPEView* view, WPEEvent* event)
+{
+    wpe_view_event(view, event);
+    wpe_event_unref(event);
+}
+
+static void handleXEvent(WPEDisplayX11* display, XEvent& xevent)
+{
+    auto* priv = display->priv;
+    auto* toplevel = static_cast<WPEToplevel*>(g_hash_table_lookup(priv->toplevels, GSIZE_TO_POINTER(xevent.xany.window)));
+    if (!toplevel)
+        return;
+    auto* toplevelPriv = WPE_TOPLEVEL_X11(toplevel)->priv;
+    auto* view = firstView(toplevel);
+
+    switch (xevent.type) {
+    case ConfigureNotify: {
+        int width, height;
+        wpe_toplevel_get_size(toplevel, &width, &height);
+        if (width == xevent.xconfigure.width && height == xevent.xconfigure.height)
+            break;
+        wpe_toplevel_resized(toplevel, xevent.xconfigure.width, xevent.xconfigure.height);
+        if (view)
+            wpe_view_resized(view, xevent.xconfigure.width, xevent.xconfigure.height);
+        break;
+    }
+    case ClientMessage:
+        if (xevent.xclient.message_type == priv->wmProtocols && static_cast<Atom>(xevent.xclient.data.l[0]) == priv->wmDeleteWindow)
+            wpe_toplevel_closed(toplevel);
+        break;
+    case FocusIn:
+    case FocusOut: {
+        auto state = wpe_toplevel_get_state(toplevel);
+        if (xevent.type == FocusIn)
+            state = static_cast<WPEToplevelState>(state | WPE_TOPLEVEL_STATE_ACTIVE);
+        else
+            state = static_cast<WPEToplevelState>(state & ~WPE_TOPLEVEL_STATE_ACTIVE);
+        wpe_toplevel_state_changed(toplevel, state);
+        if (view) {
+            if (xevent.type == FocusIn)
+                wpe_view_focus_in(view);
+            else
+                wpe_view_focus_out(view);
+        }
+        break;
+    }
+    case EnterNotify:
+    case LeaveNotify:
+        if (!view)
+            break;
+        toplevelPriv->pointerX = xevent.xcrossing.x;
+        toplevelPriv->pointerY = xevent.xcrossing.y;
+        toplevelPriv->hasPointerPosition = xevent.type == EnterNotify;
+        sendEvent(view, wpe_event_pointer_move_new(xevent.type == EnterNotify ? WPE_EVENT_POINTER_ENTER : WPE_EVENT_POINTER_LEAVE,
+            view, WPE_INPUT_SOURCE_MOUSE, xevent.xcrossing.time, modifiersFromState(xevent.xcrossing.state),
+            xevent.xcrossing.x, xevent.xcrossing.y, 0, 0));
+        break;
+    case MotionNotify: {
+        if (!view)
+            break;
+        double deltaX = toplevelPriv->hasPointerPosition ? xevent.xmotion.x - toplevelPriv->pointerX : 0;
+        double deltaY = toplevelPriv->hasPointerPosition ? xevent.xmotion.y - toplevelPriv->pointerY : 0;
+        toplevelPriv->pointerX = xevent.xmotion.x;
+        toplevelPriv->pointerY = xevent.xmotion.y;
+        toplevelPriv->hasPointerPosition = true;
+        sendEvent(view, wpe_event_pointer_move_new(WPE_EVENT_POINTER_MOVE, view, WPE_INPUT_SOURCE_MOUSE, xevent.xmotion.time,
+            modifiersFromState(xevent.xmotion.state), xevent.xmotion.x, xevent.xmotion.y, deltaX, deltaY));
+        break;
+    }
+    case ButtonPress:
+    case ButtonRelease: {
+        if (!view)
+            break;
+        unsigned button = xevent.xbutton.button;
+        auto modifiers = modifiersFromState(xevent.xbutton.state);
+        // Buttons 4 to 7 are the scroll wheel: one press is one notch.
+        if (button >= 4 && button <= 7) {
+            if (xevent.type == ButtonRelease)
+                break;
+            static const double notch = 40;
+            double deltaX = button == 6 ? notch : button == 7 ? -notch : 0;
+            double deltaY = button == 4 ? notch : button == 5 ? -notch : 0;
+            sendEvent(view, wpe_event_scroll_new(view, WPE_INPUT_SOURCE_MOUSE, xevent.xbutton.time, modifiers,
+                deltaX, deltaY, FALSE, FALSE, xevent.xbutton.x, xevent.xbutton.y));
+            break;
+        }
+        // X numbers buttons left, middle, right as 1, 2, 3; so does WPE.
+        guint pressCount = 0;
+        if (xevent.type == ButtonPress)
+            pressCount = wpe_view_compute_press_count(view, xevent.xbutton.x, xevent.xbutton.y, button, xevent.xbutton.time);
+        sendEvent(view, wpe_event_pointer_button_new(xevent.type == ButtonPress ? WPE_EVENT_POINTER_DOWN : WPE_EVENT_POINTER_UP,
+            view, WPE_INPUT_SOURCE_MOUSE, xevent.xbutton.time, modifiers, button, xevent.xbutton.x, xevent.xbutton.y, pressCount));
+        break;
+    }
+    case KeyPress:
+    case KeyRelease: {
+        if (!view)
+            break;
+        // X keysyms and WPE key values are the same numbering.
+        KeySym keysym = 0;
+        char text[16];
+        XLookupString(&xevent.xkey, text, sizeof(text), &keysym, nullptr);
+        sendEvent(view, wpe_event_keyboard_new(xevent.type == KeyPress ? WPE_EVENT_KEYBOARD_KEY_DOWN : WPE_EVENT_KEYBOARD_KEY_UP,
+            view, WPE_INPUT_SOURCE_KEYBOARD, xevent.xkey.time, modifiersFromState(xevent.xkey.state),
+            xevent.xkey.keycode, static_cast<guint>(keysym)));
+        break;
+    }
+    default:
+        break;
+    }
+}
+
+struct XEventSource {
+    GSource source;
+    WPEDisplayX11* display;
+};
+
+static GSourceFuncs xEventSourceFuncs = {
+    // prepare
+    [](GSource* source, int* timeout) -> gboolean {
+        *timeout = -1;
+        return XPending(reinterpret_cast<XEventSource*>(source)->display->priv->xdisplay) > 0;
+    },
+    // check
+    [](GSource* source) -> gboolean {
+        auto* priv = reinterpret_cast<XEventSource*>(source)->display->priv;
+        return (priv->pollFD.revents & G_IO_IN) || XPending(priv->xdisplay) > 0;
+    },
+    // dispatch
+    [](GSource* source, GSourceFunc, gpointer) -> gboolean {
+        auto* display = reinterpret_cast<XEventSource*>(source)->display;
+        GRefPtr<WPEDisplayX11> protect(display);
+        while (display->priv->xdisplay && XPending(display->priv->xdisplay) > 0) {
+            XEvent xevent;
+            XNextEvent(display->priv->xdisplay, &xevent);
+            handleXEvent(display, xevent);
+        }
+        return G_SOURCE_CONTINUE;
+    },
+    nullptr, // finalize
+    nullptr, // closure_callback
+    nullptr, // closure_marshall
+};
+
+static void wpeDisplayX11Dispose(GObject* object)
+{
+    auto* priv = WPE_DISPLAY_X11(object)->priv;
+    if (priv->eventSource) {
+        g_source_destroy(priv->eventSource.get());
+        priv->eventSource = nullptr;
+    }
+    g_clear_pointer(&priv->toplevels, g_hash_table_unref);
+    if (priv->xdisplay) {
+        XCloseDisplay(priv->xdisplay);
+        priv->xdisplay = nullptr;
+    }
+    G_OBJECT_CLASS(wpe_display_x11_parent_class)->dispose(object);
+}
+
+static gboolean wpeDisplayX11Connect(WPEDisplay* display, GError** error)
+{
+    auto* priv = WPE_DISPLAY_X11(display)->priv;
+    if (priv->xdisplay)
+        return TRUE;
+
+    // With no libX11 on the system the stand-in returns null here as well.
+    const char* name = g_getenv("DISPLAY");
+    priv->xdisplay = name && *name ? XOpenDisplay(nullptr) : nullptr;
+    if (!priv->xdisplay) {
+        g_set_error_literal(error, WPE_DISPLAY_ERROR, WPE_DISPLAY_ERROR_CONNECTION_FAILED, "Failed to connect to an X display");
+        return FALSE;
+    }
+
+    priv->wmProtocols = XInternAtom(priv->xdisplay, "WM_PROTOCOLS", False);
+    priv->wmDeleteWindow = XInternAtom(priv->xdisplay, "WM_DELETE_WINDOW", False);
+    priv->netWMName = XInternAtom(priv->xdisplay, "_NET_WM_NAME", False);
+    priv->utf8String = XInternAtom(priv->xdisplay, "UTF8_STRING", False);
+    priv->netWMState = XInternAtom(priv->xdisplay, "_NET_WM_STATE", False);
+    priv->netWMStateFullscreen = XInternAtom(priv->xdisplay, "_NET_WM_STATE_FULLSCREEN", False);
+    priv->netWMStateMaximizedVert = XInternAtom(priv->xdisplay, "_NET_WM_STATE_MAXIMIZED_VERT", False);
+    priv->netWMStateMaximizedHorz = XInternAtom(priv->xdisplay, "_NET_WM_STATE_MAXIMIZED_HORZ", False);
+    priv->toplevels = g_hash_table_new(g_direct_hash, g_direct_equal);
+
+    auto* source = g_source_new(&xEventSourceFuncs, sizeof(XEventSource));
+    reinterpret_cast<XEventSource*>(source)->display = WPE_DISPLAY_X11(display);
+    priv->eventSource = adoptGRef(source);
+    priv->pollFD.fd = ConnectionNumber(priv->xdisplay);
+    priv->pollFD.events = G_IO_IN | G_IO_ERR | G_IO_HUP;
+    priv->pollFD.revents = 0;
+    g_source_add_poll(source, &priv->pollFD);
+    g_source_set_name(source, "WPE X11 events");
+    g_source_set_priority(source, RunLoopSourcePriority::RunLoopDispatcher);
+    g_source_attach(source, g_main_context_get_thread_default());
+    return TRUE;
+}
+
+static WPEView* wpeDisplayX11CreateView(WPEDisplay* display)
+{
+    return WPE_VIEW(g_object_new(WPE_TYPE_VIEW_X11, "display", display, nullptr));
+}
+
+static WPEToplevel* wpeDisplayX11CreateToplevel(WPEDisplay* display, guint)
+{
+    return WPE_TOPLEVEL(g_object_new(WPE_TYPE_TOPLEVEL_X11, "display", display, nullptr));
+}
+
+static void wpe_display_x11_class_init(WPEDisplayX11Class* displayX11Class)
+{
+    GObjectClass* objectClass = G_OBJECT_CLASS(displayX11Class);
+    objectClass->dispose = wpeDisplayX11Dispose;
+
+    WPEDisplayClass* displayClass = WPE_DISPLAY_CLASS(displayX11Class);
+    displayClass->connect = wpeDisplayX11Connect;
+    displayClass->create_view = wpeDisplayX11CreateView;
+    displayClass->create_toplevel = wpeDisplayX11CreateToplevel;
+    // No get_drm_device and no get_egl_display: pages render in the web
+    // process and arrive here as shared-memory pixel buffers.
+}
+
+WPEDisplay* wpe_display_x11_new()
+{
+    return WPE_DISPLAY(g_object_new(WPE_TYPE_DISPLAY_X11, nullptr));
+}
+
+// --------------------------------------------------------------- toplevel --
+
+static void wpeToplevelX11Constructed(GObject* object)
+{
+    G_OBJECT_CLASS(wpe_toplevel_x11_parent_class)->constructed(object);
+
+    auto* toplevel = WPE_TOPLEVEL(object);
+    auto* priv = WPE_TOPLEVEL_X11(object)->priv;
+    auto* display = WPE_DISPLAY_X11(wpe_toplevel_get_display(toplevel));
+    auto* xdisplay = display->priv->xdisplay;
+    if (!xdisplay)
+        return;
+
+    int width, height;
+    wpe_toplevel_get_size(toplevel, &width, &height);
+    if (width <= 0 || height <= 0) {
+        width = 1024;
+        height = 768;
+    }
+
+    int screen = DefaultScreen(xdisplay);
+    priv->window = XCreateSimpleWindow(xdisplay, RootWindow(xdisplay, screen), 0, 0, width, height, 0,
+        BlackPixel(xdisplay, screen), WhitePixel(xdisplay, screen));
+    XSelectInput(xdisplay, priv->window, StructureNotifyMask | FocusChangeMask | EnterWindowMask | LeaveWindowMask
+        | PointerMotionMask | ButtonPressMask | ButtonReleaseMask | KeyPressMask | KeyReleaseMask);
+    Atom protocols[] = { display->priv->wmDeleteWindow };
+    XSetWMProtocols(xdisplay, priv->window, protocols, 1);
+    priv->gc = XCreateGC(xdisplay, priv->window, 0, nullptr);
+    g_hash_table_insert(display->priv->toplevels, GSIZE_TO_POINTER(priv->window), toplevel);
+    XMapWindow(xdisplay, priv->window);
+    XFlush(xdisplay);
+
+    wpe_toplevel_resized(toplevel, width, height);
+    wpe_toplevel_state_changed(toplevel, WPE_TOPLEVEL_STATE_ACTIVE);
+}
+
+static void wpeToplevelX11Dispose(GObject* object)
+{
+    auto* toplevel = WPE_TOPLEVEL(object);
+    auto* priv = WPE_TOPLEVEL_X11(object)->priv;
+    auto* wpeDisplay = wpe_toplevel_get_display(toplevel);
+    if (priv->window && wpeDisplay && xDisplayOf(wpeDisplay)) {
+        auto* display = WPE_DISPLAY_X11(wpeDisplay);
+        auto* xdisplay = display->priv->xdisplay;
+        if (display->priv->toplevels)
+            g_hash_table_remove(display->priv->toplevels, GSIZE_TO_POINTER(priv->window));
+        if (priv->gc)
+            XFreeGC(xdisplay, priv->gc);
+        XDestroyWindow(xdisplay, priv->window);
+        XFlush(xdisplay);
+    }
+    priv->window = 0;
+    priv->gc = nullptr;
+    G_OBJECT_CLASS(wpe_toplevel_x11_parent_class)->dispose(object);
+}
+
+static void wpeToplevelX11SetTitle(WPEToplevel* toplevel, const char* title)
+{
+    auto* priv = WPE_TOPLEVEL_X11(toplevel)->priv;
+    auto* display = WPE_DISPLAY_X11(wpe_toplevel_get_display(toplevel));
+    if (!priv->window || !title)
+        return;
+    XStoreName(display->priv->xdisplay, priv->window, title);
+    XChangeProperty(display->priv->xdisplay, priv->window, display->priv->netWMName, display->priv->utf8String, 8,
+        PropModeReplace, reinterpret_cast<const unsigned char*>(title), strlen(title));
+    XFlush(display->priv->xdisplay);
+}
+
+static gboolean wpeToplevelX11Resize(WPEToplevel* toplevel, int width, int height)
+{
+    auto* priv = WPE_TOPLEVEL_X11(toplevel)->priv;
+    if (!priv->window || width <= 0 || height <= 0)
+        return FALSE;
+    auto* xdisplay = xDisplayOf(wpe_toplevel_get_display(toplevel));
+    XResizeWindow(xdisplay, priv->window, width, height);
+    XFlush(xdisplay);
+    // The window manager may refuse or adjust; ConfigureNotify corrects us.
+    wpe_toplevel_resized(toplevel, width, height);
+    if (auto* view = firstView(toplevel))
+        wpe_view_resized(view, width, height);
+    return TRUE;
+}
+
+// Ask the window manager to add or remove up to two _NET_WM_STATE atoms.
+static void changeWMState(WPEToplevel* toplevel, bool add, Atom first, Atom second)
+{
+    auto* priv = WPE_TOPLEVEL_X11(toplevel)->priv;
+    auto* display = WPE_DISPLAY_X11(wpe_toplevel_get_display(toplevel));
+    auto* xdisplay = display->priv->xdisplay;
+    XEvent xevent;
+    memset(&xevent, 0, sizeof(xevent));
+    xevent.xclient.type = ClientMessage;
+    xevent.xclient.window = priv->window;
+    xevent.xclient.message_type = display->priv->netWMState;
+    xevent.xclient.format = 32;
+    xevent.xclient.data.l[0] = add ? 1 : 0;
+    xevent.xclient.data.l[1] = first;
+    xevent.xclient.data.l[2] = second;
+    xevent.xclient.data.l[3] = 1;
+    XSendEvent(xdisplay, DefaultRootWindow(xdisplay), False, SubstructureNotifyMask | SubstructureRedirectMask, &xevent);
+    XFlush(xdisplay);
+}
+
+static gboolean wpeToplevelX11SetFullscreen(WPEToplevel* toplevel, gboolean fullscreen)
+{
+    if (!WPE_TOPLEVEL_X11(toplevel)->priv->window)
+        return FALSE;
+    auto* display = WPE_DISPLAY_X11(wpe_toplevel_get_display(toplevel));
+    changeWMState(toplevel, fullscreen, display->priv->netWMStateFullscreen, xNone);
+    auto state = wpe_toplevel_get_state(toplevel);
+    if (fullscreen)
+        state = static_cast<WPEToplevelState>(state | WPE_TOPLEVEL_STATE_FULLSCREEN);
+    else
+        state = static_cast<WPEToplevelState>(state & ~WPE_TOPLEVEL_STATE_FULLSCREEN);
+    wpe_toplevel_state_changed(toplevel, state);
+    return TRUE;
+}
+
+static gboolean wpeToplevelX11SetMaximized(WPEToplevel* toplevel, gboolean maximized)
+{
+    if (!WPE_TOPLEVEL_X11(toplevel)->priv->window)
+        return FALSE;
+    auto* display = WPE_DISPLAY_X11(wpe_toplevel_get_display(toplevel));
+    changeWMState(toplevel, maximized, display->priv->netWMStateMaximizedVert, display->priv->netWMStateMaximizedHorz);
+    auto state = wpe_toplevel_get_state(toplevel);
+    if (maximized)
+        state = static_cast<WPEToplevelState>(state | WPE_TOPLEVEL_STATE_MAXIMIZED);
+    else
+        state = static_cast<WPEToplevelState>(state & ~WPE_TOPLEVEL_STATE_MAXIMIZED);
+    wpe_toplevel_state_changed(toplevel, state);
+    return TRUE;
+}
+
+static gboolean wpeToplevelX11SetMinimized(WPEToplevel* toplevel)
+{
+    auto* priv = WPE_TOPLEVEL_X11(toplevel)->priv;
+    if (!priv->window)
+        return FALSE;
+    auto* xdisplay = xDisplayOf(wpe_toplevel_get_display(toplevel));
+    XIconifyWindow(xdisplay, priv->window, DefaultScreen(xdisplay));
+    XFlush(xdisplay);
+    return TRUE;
+}
+
+static void wpe_toplevel_x11_class_init(WPEToplevelX11Class* toplevelX11Class)
+{
+    GObjectClass* objectClass = G_OBJECT_CLASS(toplevelX11Class);
+    objectClass->constructed = wpeToplevelX11Constructed;
+    objectClass->dispose = wpeToplevelX11Dispose;
+
+    WPEToplevelClass* toplevelClass = WPE_TOPLEVEL_CLASS(toplevelX11Class);
+    toplevelClass->set_title = wpeToplevelX11SetTitle;
+    toplevelClass->resize = wpeToplevelX11Resize;
+    toplevelClass->set_fullscreen = wpeToplevelX11SetFullscreen;
+    toplevelClass->set_maximized = wpeToplevelX11SetMaximized;
+    toplevelClass->set_minimized = wpeToplevelX11SetMinimized;
+}
+
+// ------------------------------------------------------------------- view --
+
+static GSourceFuncs frameSourceFuncs = {
+    nullptr, // prepare
+    nullptr, // check
+    // dispatch
+    [](GSource* source, GSourceFunc callback, gpointer userData) -> gboolean {
+        if (g_source_get_ready_time(source) == -1)
+            return G_SOURCE_CONTINUE;
+        g_source_set_ready_time(source, -1);
+        return callback(userData);
+    },
+    nullptr, // finalize
+    nullptr, // closure_callback
+    nullptr, // closure_marshall
+};
+
+// Copy a rendered buffer into the toplevel's window.
+static void presentBuffer(WPEView* view, WPEBuffer* buffer)
+{
+    auto* toplevel = wpe_view_get_toplevel(view);
+    if (!toplevel)
+        return;
+    auto* toplevelPriv = WPE_TOPLEVEL_X11(toplevel)->priv;
+    auto* xdisplay = xDisplayOf(wpe_view_get_display(view));
+    if (!xdisplay || !toplevelPriv->window)
+        return;
+
+    GUniqueOutPtr<GError> error;
+    GBytes* pixels = wpe_buffer_import_to_pixels(buffer, &error.outPtr());
+    if (!pixels)
+        return;
+
+    int width = wpe_buffer_get_width(buffer);
+    int height = wpe_buffer_get_height(buffer);
+    int stride = WPE_IS_BUFFER_SHM(buffer) ? wpe_buffer_shm_get_stride(WPE_BUFFER_SHM(buffer)) : width * 4;
+    gsize size = 0;
+    auto* data = static_cast<const char*>(g_bytes_get_data(pixels, &size));
+    if (!data || width <= 0 || height <= 0 || size < static_cast<gsize>(stride) * height)
+        return;
+
+    // The buffer is 32-bit BGRA in memory, which is what a 24-bit TrueColor
+    // visual on a little-endian server takes as a ZPixmap. Other visuals are
+    // not handled.
+    int screen = DefaultScreen(xdisplay);
+    if (DefaultDepth(xdisplay, screen) != 24 && DefaultDepth(xdisplay, screen) != 32)
+        return;
+    XImage image;
+    memset(&image, 0, sizeof(image));
+    image.width = width;
+    image.height = height;
+    image.format = ZPixmap;
+    image.data = const_cast<char*>(data);
+    image.byte_order = LSBFirst;
+    image.bitmap_unit = 32;
+    image.bitmap_bit_order = LSBFirst;
+    image.bitmap_pad = 32;
+    image.depth = DefaultDepth(xdisplay, screen);
+    image.bytes_per_line = stride;
+    image.bits_per_pixel = 32;
+    image.red_mask = 0xff0000;
+    image.green_mask = 0x00ff00;
+    image.blue_mask = 0x0000ff;
+    if (!XInitImage(&image))
+        return;
+    XPutImage(xdisplay, toplevelPriv->window, toplevelPriv->gc, &image, 0, 0, 0, 0, width, height);
+    XFlush(xdisplay);
+}
+
+static void wpeViewX11Constructed(GObject* object)
+{
+    G_OBJECT_CLASS(wpe_view_x11_parent_class)->constructed(object);
+
+    auto* view = WPE_VIEW(object);
+    g_signal_connect(view, "notify::toplevel", G_CALLBACK(+[](WPEView* view, GParamSpec*, gpointer) {
+        auto* toplevel = wpe_view_get_toplevel(view);
+        if (!toplevel) {
+            wpe_view_unmap(view);
+            return;
+        }
+        // (One declaration per line: this is inside a macro argument.)
+        int width;
+        int height;
+        wpe_toplevel_get_size(toplevel, &width, &height);
+        if (width && height)
+            wpe_view_resized(view, width, height);
+        wpe_view_map(view);
+    }), nullptr);
+
+    // Frames are paced at 60 per second, as the headless backend does: X has
+    // no frame callback in the core protocol.
+    auto* priv = WPE_VIEW_X11(view)->priv;
+    priv->frameSource = adoptGRef(g_source_new(&frameSourceFuncs, sizeof(GSource)));
+    g_source_set_priority(priv->frameSource.get(), RunLoopSourcePriority::RunLoopTimer);
+    g_source_set_name(priv->frameSource.get(), "WPE X11 frame timer");
+    g_source_set_callback(priv->frameSource.get(), [](gpointer userData) -> gboolean {
+        auto* view = WPE_VIEW(userData);
+        auto* priv = WPE_VIEW_X11(view)->priv;
+        if (priv->committedBuffer)
+            wpe_view_buffer_released(view, priv->committedBuffer.get());
+        priv->committedBuffer = WTF::move(priv->pendingBuffer);
+        if (priv->committedBuffer) {
+            presentBuffer(view, priv->committedBuffer.get());
+            wpe_view_buffer_rendered(view, priv->committedBuffer.get());
+        }
+        if (g_source_is_destroyed(priv->frameSource.get()))
+            return G_SOURCE_REMOVE;
+        return G_SOURCE_CONTINUE;
+    }, object, nullptr);
+    g_source_attach(priv->frameSource.get(), g_main_context_get_thread_default());
+    g_source_set_ready_time(priv->frameSource.get(), -1);
+}
+
+static void wpeViewX11Dispose(GObject* object)
+{
+    auto* priv = WPE_VIEW_X11(object)->priv;
+    if (priv->frameSource) {
+        g_source_destroy(priv->frameSource.get());
+        priv->frameSource = nullptr;
+    }
+    G_OBJECT_CLASS(wpe_view_x11_parent_class)->dispose(object);
+}
+
+static gboolean wpeViewX11RenderBuffer(WPEView* view, WPEBuffer* buffer, const WPERectangle*, guint, GError**)
+{
+    auto* priv = WPE_VIEW_X11(view)->priv;
+    priv->pendingBuffer = buffer;
+    auto now = g_get_monotonic_time();
+    if (!priv->lastFrameTime)
+        priv->lastFrameTime = now;
+    auto next = priv->lastFrameTime + (G_USEC_PER_SEC / 60);
+    priv->lastFrameTime = now;
+    g_source_set_ready_time(priv->frameSource.get(), next <= now ? 0 : next);
+    return TRUE;
+}
+
+static void wpe_view_x11_class_init(WPEViewX11Class* viewX11Class)
+{
+    GObjectClass* objectClass = G_OBJECT_CLASS(viewX11Class);
+    objectClass->constructed = wpeViewX11Constructed;
+    objectClass->dispose = wpeViewX11Dispose;
+
+    WPEViewClass* viewClass = WPE_VIEW_CLASS(viewX11Class);
+    viewClass->render_buffer = wpeViewX11RenderBuffer;
+}
