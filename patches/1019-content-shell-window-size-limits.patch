Feature: window size limits from the embedder, and the program's window class.

Electron's windows have a smallest size and may be made not to resize
(BrowserWindow minWidth, minHeight, resizable); the content shell's
windows can always shrink to nothing. ShellPlatformDelegate::
SetWindowSizeLimits() takes them where windows are views; on macOS
zebkit sets its NSWindow's. On Linux the windows' class is the program's
name, which an application's desktop entry names (StartupWMClass), not
"chromium-content_shell".

--- a/content/shell/browser/shell_platform_delegate.h
+++ b/content/shell/browser/shell_platform_delegate.h
@@ -132,6 +132,14 @@ class ShellPlatformDelegate {
   virtual gfx::NativeWindow GetNativeWindow(Shell* shell);
 #endif
 
+  // zebkit: the smallest the window may be made (empty for no limit), and
+  // whether it may be resized at all. Defined where the windows are views
+  // (shell_platform_delegate_views.cc); on macOS the embedder sets its
+  // NSWindow's.
+  void SetWindowSizeLimits(Shell* shell,
+                           const gfx::Size& minimum,
+                           bool resizable);
+
 #if BUILDFLAG(IS_MAC)
   // Activate (make key) the native window, and focus the web contents.
   virtual void ActivateContents(Shell* shell, WebContents* contents);
--- a/content/shell/browser/shell_platform_delegate_views.cc
+++ b/content/shell/browser/shell_platform_delegate_views.cc
@@ -85,6 +85,9 @@ class ShellView : public views::BoxLayoutView,
   METADATA_HEADER(ShellView, views::BoxLayoutView)
 
  public:
+  // zebkit: the smallest the embedder lets the window be.
+  void set_minimum_size(const gfx::Size& size) { minimum_size_ = size; }
+
   enum UIControl { BACK_BUTTON, FORWARD_BUTTON, STOP_BUTTON };
 
   explicit ShellView(Shell* shell) : shell_(shell) { InitShellWindow(); }
@@ -273,8 +276,8 @@ class ShellView : public views::BoxLayoutView,
   // Overridden from View
   gfx::Size GetMinimumSize() const override {
     // We want to be able to make the window smaller than its initial
-    // (preferred) size.
-    return gfx::Size();
+    // (preferred) size, unless the embedder says how small.
+    return minimum_size_;
   }
   void AddedToWidget() override { InitAccelerators(); }
 
@@ -297,6 +300,7 @@ class ShellView : public views::BoxLayoutView,
 
  private:
   std::unique_ptr<Shell> shell_;
+  gfx::Size minimum_size_;
 
   // Window title
   std::u16string title_;
@@ -323,6 +327,19 @@ ShellView* ShellViewForWidget(views::Widget* widget) {
 
 }  // namespace
 
+void ShellPlatformDelegate::SetWindowSizeLimits(Shell* shell,
+                                                const gfx::Size& minimum,
+                                                bool resizable) {
+  DCHECK(shell_data_map_.contains(shell));
+  views::Widget* widget = shell_data_map_[shell].window_widget;
+  if (!widget)
+    return;
+  ShellViewForWidget(widget)->set_minimum_size(minimum);
+  widget->widget_delegate()->SetCanResize(resizable);
+  widget->widget_delegate()->SetCanMaximize(resizable);
+  widget->OnSizeConstraintsChanged();
+}
+
 ShellPlatformDelegate::ShellPlatformDelegate() = default;
 
 void ShellPlatformDelegate::Initialize(const gfx::Size& default_window_size) {
@@ -375,7 +392,12 @@ void ShellPlatformDelegate::CreatePlatformWindow(
   params.bounds = gfx::Rect(initial_size);
   params.delegate = delegate.release();
 #if BUILDFLAG(IS_LINUX)
-  params.wm_class_class = "chromium-content_shell";
+  // zebkit: the application's own class, which its desktop entry names
+  // (StartupWMClass), as Electron's windows have: the program's name.
+  params.wm_class_class = base::CommandLine::ForCurrentProcess()
+                              ->GetProgram()
+                              .BaseName()
+                              .AsUTF8Unsafe();
   params.wm_class_name = params.wm_class_class;
 #endif  // BUILDFLAG(IS_LINUX)
   shell_data.window_widget->Init(std::move(params));
