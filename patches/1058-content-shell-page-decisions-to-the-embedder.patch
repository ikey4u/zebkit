+  // zebkit: decisions of the embedder's, before the shell's own.
+  class EmbedderHooks {
+   public:
+    virtual ~EmbedderHooks() = default;
+    // True: the page does not get this key.
+    virtual bool KeyBeforePage(WebContents* contents,
+                               const input::NativeWebKeyboardEvent& event) = 0;
+    // True: no menu of the shell's.
+    virtual bool ContextMenu(RenderFrameHost& frame,
+                             const ContextMenuParams& params) = 0;
+    virtual bool CanEnterFullscreen(RenderFrameHost* frame) = 0;
+    virtual void FullscreenChanged(WebContents* contents, bool entered) = 0;
+    // True: the embedder has taken @callback and answers it.
+    virtual bool MediaAccess(WebContents* contents,
+                             const MediaStreamRequest& request,
+                             MediaResponseCallback& callback) = 0;
+  };
