+// zebkit: LevelDB's names are the path's own bytes. Converting them through
+// UTF-8 depends on the locale on POSIX, which is the application's: a
+// non-ASCII path fails under the C locale.
+static base::FilePath PathFromName(const std::string& name) {
+#if BUILDFLAG(IS_WIN)
+  return base::FilePath::FromUTF8Unsafe(name);
+#else
+  return base::FilePath(name);
+#endif
+}
+static std::string NameFromPath(const base::FilePath& path) {
+#if BUILDFLAG(IS_WIN)
+  return path.AsUTF8Unsafe();
+#else
+  return path.value();
+#endif
+}
