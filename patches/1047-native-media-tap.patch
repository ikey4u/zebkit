+std::vector<WebMediaStreamTrack> GetWebMediaAudioTracks(const WebElement& element) {
+  std::vector<WebMediaStreamTrack> tracks;
+  if (element.IsNull()) return tracks;
+  const auto* media = DynamicTo<HTMLMediaElement>(*element.ConstUnwrap<Element>());
+  if (!media) return tracks;
+  auto source = media->GetSrcObjectVariant();
+  auto* stream = std::get_if<MediaStreamDescriptor*>(&source);
+  if (stream && *stream)
+    for (const auto& component : (*stream)->AudioComponents())
+      tracks.emplace_back(component.Get());
+  return tracks;
+}
+
 }  // namespace blink
