+// The features of the command line (--enable-features, --disable-features,
+// and those its other switches imply) and the field trials it forces, in
+// place of SetupFieldTrials(), which is test support and also applies
+// Chromium's testing configuration of field trials.
+void SetupFeatureList() {
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  // Child processes are sent the trials in this list.
+  static base::NoDestructor<base::FieldTrialList> field_trial_list;
+  base::FieldTrialList::CreateTrialsFromString(
+      command_line.GetSwitchValueASCII(::switches::kForceFieldTrials));
+  auto feature_list = std::make_unique<base::FeatureList>();
+  feature_list->InitFromCommandLine(
+      command_line.GetSwitchValueASCII(::switches::kEnableFeatures),
+      command_line.GetSwitchValueASCII(::switches::kDisableFeatures));
+  feature_list->RegisterExtraFeatureOverrides(
+      GetSwitchDependentFeatureOverrides(command_line));
+  base::FeatureList::SetInstance(std::move(feature_list));
+}
