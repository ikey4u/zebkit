Content shell: keep test-only bundle rewriting out of library hosts.

EnsureCorrectResolutionSettings reads and may rewrite the application's
Info.plist, then re-executes it to toggle Retina behavior for web tests.
It assumes the executable lives in an app bundle and DCHECKs for CLI
embedders such as Python or an off-screen renderer. zebkit's host owns
its bundle settings; the browser example supplies NSHighResolutionCapable.
Retain the content shell's resolution adjustment when web-test support
is built, alongside its other test-only startup behavior.

--- a/content/shell/app/shell_main_delegate.cc
+++ b/content/shell/app/shell_main_delegate.cc
@@ -236,10 +236,10 @@ std::optional<int> ShellMainDelegate::BasicStartupComplete() {
   base::win::EnableStrictHandleCheckingForCurrentProcess();
 #endif
 
-#if BUILDFLAG(IS_MAC)
+#if BUILDFLAG(IS_MAC) && defined(CONTENT_SHELL_WEB_TESTS)
   // Needs to happen before InitializeResourceBundle().
   EnsureCorrectResolutionSettings();
-#endif  // BUILDFLAG(IS_MAC)
+#endif  // BUILDFLAG(IS_MAC) && defined(CONTENT_SHELL_WEB_TESTS)
 
   InitLogging(command_line);
 
