Port: define C library functions that glibc 2.17 lacks.

Building against glibc 2.17 left one unresolved symbol in the engine,
roundeven() (glibc 2.25): the optimizer recognises WTF's portable fallback
and calls the library function again. This adds a small source file with
hidden definitions of roundeven() and roundevenf(), so the engine neither
imports them nor conflicts with a newer glibc at run time.

--- a/Source/WTF/wtf/PlatformWPE.cmake
+++ b/Source/WTF/wtf/PlatformWPE.cmake
@@ -1,4 +1,5 @@
 list(APPEND WTF_SOURCES
+    glib/OldGlibcCompat.cpp
     android/LoggingAndroid.cpp
     android/RefPtrAndroid.cpp
 
--- /dev/null
+++ b/Source/WTF/wtf/glib/OldGlibcCompat.cpp
@@ -0,0 +1,38 @@
+/*
+ * zebkit: C library functions that the oldest supported glibc lacks.
+ *
+ * The engine is built against glibc 2.17. Functions added to glibc later
+ * must not be imported from it, so the ones the compiler or WebKit still
+ * reaches for are defined here. They are hidden, so they never clash with a
+ * newer glibc on the machine the engine runs on.
+ */
+
+#include "config.h"
+
+#include <cmath>
+
+extern "C" {
+
+// roundeven() and roundevenf() arrived in glibc 2.25. The optimizer turns
+// WTF's portable fallback back into calls to them.
+// The asm labels give these the C names without redeclaring <math.h>'s.
+double zebkitRoundEven(double) __asm__("roundeven") __attribute__((visibility("hidden")));
+float zebkitRoundEvenF(float) __asm__("roundevenf") __attribute__((visibility("hidden")));
+
+double zebkitRoundEven(double value)
+{
+    double rounded = std::round(value);
+    if (std::fabs(value - rounded) == 0.5 && std::fmod(rounded, 2.0) != 0.0)
+        return rounded - std::copysign(1.0, value);
+    return rounded;
+}
+
+float zebkitRoundEvenF(float value)
+{
+    float rounded = std::round(value);
+    if (std::fabs(value - rounded) == 0.5f && std::fmod(rounded, 2.0f) != 0.0f)
+        return rounded - std::copysign(1.0f, value);
+    return rounded;
+}
+
+} // extern "C"
