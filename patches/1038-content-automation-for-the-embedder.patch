+// Copyright 2026 The zebkit Authors
+// zebkit: content/public/browser/zebkit_automation.h.
+
+#include "content/public/browser/zebkit_automation.h"
+
+#include <utility>
+
+#include "base/time/time.h"
+#include "components/input/render_input_router.h"
+#include "components/input/render_widget_host_input_event_router.h"
+#include "content/browser/renderer_host/render_frame_host_impl.h"
+#include "content/browser/renderer_host/render_widget_host_impl.h"
+#include "content/browser/renderer_host/render_widget_host_view_base.h"
+#include "content/browser/web_contents/web_contents_impl.h"
+#include "services/device/public/mojom/geolocation_context.mojom.h"
+#include "services/device/public/mojom/geoposition.mojom.h"
+#include "third_party/blink/public/common/input/web_touch_event.h"
+#include "ui/latency/latency_info.h"
+
+namespace content {
+
+void FindWidgetAtPoint(WebContents* contents,
+                       const gfx::PointF& point,
+                       WidgetAtPointCallback callback) {
+  auto* impl = static_cast<WebContentsImpl*>(contents);
+  auto* root =
+      static_cast<RenderWidgetHostViewBase*>(impl->GetRenderWidgetHostView());
+  if (!root) {
+    std::move(callback).Run(nullptr, point);
+    return;
+  }
+  impl->GetRenderWidgetHostAtPointAsynchronously(
+      root, point,
+      base::BindOnce(
+          [](WidgetAtPointCallback callback,
+             base::WeakPtr<RenderWidgetHostViewBase> target,
+             std::optional<gfx::PointF> local) {
+            if (!target || !local) {
+              std::move(callback).Run(nullptr, gfx::PointF());
+              return;
+            }
+            std::move(callback).Run(target->GetRenderWidgetHost(), *local);
+          },
+          std::move(callback)));
+}
+
+void ForwardTouchEvent(RenderWidgetHost* widget,
+                       const blink::WebTouchEvent& event) {
+  RenderWidgetHostImpl::From(widget)
+      ->GetRenderInputRouter()
+      ->ForwardTouchEventWithLatencyInfo(event, ui::LatencyInfo());
+}
+
+void SetGeolocationOverride(WebContents* contents,
+                            std::optional<GeolocationOverride> position) {
+  device::mojom::GeolocationContext* context =
+      static_cast<WebContentsImpl*>(contents)->GetGeolocationContext();
+  if (!context)
+    return;
+  if (!position) {
+    context->ClearOverride();
+    return;
+  }
+  auto geoposition = device::mojom::Geoposition::New();
+  geoposition->latitude = position->latitude;
+  geoposition->longitude = position->longitude;
+  geoposition->accuracy = position->accuracy;
+  geoposition->timestamp = base::Time::Now();
+  context->SetOverride(
+      device::mojom::GeopositionResult::NewPosition(std::move(geoposition)));
+}
+
+void UpdateSubresourceLoaderFactories(RenderFrameHost* frame) {
+  static_cast<RenderFrameHostImpl*>(frame)->UpdateSubresourceLoaderFactories();
+}
+
+}  // namespace content
