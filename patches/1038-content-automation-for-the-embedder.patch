+// Copyright 2026 The zebkit Authors
+// zebkit: what the embedder's automation (Playwright's API without DevTools)
+// needs of content that its public API does not give: input to the widget
+// under a point, as DevTools' Input domain sends it; touch input; the
+// geolocation a page reads; a frame's loader factories made again, as
+// DevTools' Fetch domain makes them when it starts intercepting.
+
+#ifndef CONTENT_PUBLIC_BROWSER_ZEBKIT_AUTOMATION_H_
+#define CONTENT_PUBLIC_BROWSER_ZEBKIT_AUTOMATION_H_
+
+#include <optional>
+
+#include "base/functional/callback.h"
+#include "content/common/content_export.h"
+#include "ui/gfx/geometry/point_f.h"
+
+namespace blink {
+class WebTouchEvent;
+}  // namespace blink
+
+namespace content {
+
+class RenderFrameHost;
+class RenderWidgetHost;
+class WebContents;
+
+// The widget of @contents at @point (in its main frame's view), a frame of
+// another site's included, and the point in that widget; nullptr when there
+// is none. Asynchronous, as the browser's hit test of the frames may be.
+using WidgetAtPointCallback =
+    base::OnceCallback<void(RenderWidgetHost* widget, gfx::PointF point)>;
+CONTENT_EXPORT void FindWidgetAtPoint(WebContents* contents,
+                                      const gfx::PointF& point,
+                                      WidgetAtPointCallback callback);
+
+// A touch event to @widget, as a touchscreen's.
+CONTENT_EXPORT void ForwardTouchEvent(RenderWidgetHost* widget,
+                                      const blink::WebTouchEvent& event);
+
+// The position @contents' pages get from the Geolocation API, or the
+// device's again (nullopt).
+struct GeolocationOverride {
+  double latitude = 0;
+  double longitude = 0;
+  double accuracy = 0;
+};
+CONTENT_EXPORT void SetGeolocationOverride(
+    WebContents* contents,
+    std::optional<GeolocationOverride> position);
+
+// @frame's subresource loader factories made again, through
+// ContentBrowserClient::WillCreateURLLoaderFactory().
+CONTENT_EXPORT void UpdateSubresourceLoaderFactories(RenderFrameHost* frame);
+
+}  // namespace content
+
+#endif  // CONTENT_PUBLIC_BROWSER_ZEBKIT_AUTOMATION_H_
