Feature: keys a page did not take, to the embedder.

The content shell passes the keys a page leaves to its platform delegate
on macOS only, where the menu bar takes its own. zebkit's application menu
works by its keys in the windows of the other platforms, which have no
menu bar: Shell::SetKeyboardEventHandler() gives the embedder each such key
first, on every platform.

--- a/content/shell/browser/shell.h
+++ b/content/shell/browser/shell.h
@@ -101,6 +101,13 @@
       base::RepeatingCallback<bool(WebContents* opener, const GURL& url)>;
   static void SetNewWindowHandler(NewWindowHandler handler);
 
+  // zebkit: a key the page did not take goes to the embedder first, which
+  // returns true when it takes it (the application menu's keys).
+  using KeyboardEventHandler = base::RepeatingCallback<bool(
+      Shell* shell,
+      const input::NativeWebKeyboardEvent& event)>;
+  static void SetKeyboardEventHandler(KeyboardEventHandler handler);
+
   static bool ShouldHideToolbar();
 
   WebContents* web_contents() const { return web_contents_.get(); }
@@ -167,10 +174,8 @@
                               InvalidateTypes changed_flags) override;
   JavaScriptDialogManager* GetJavaScriptDialogManager(
       WebContents* source) override;
-#if BUILDFLAG(IS_MAC)
   bool HandleKeyboardEvent(WebContents* source,
                            const input::NativeWebKeyboardEvent& event) override;
-#endif
   bool DidAddMessageToConsole(WebContents* source,
                               blink::mojom::ConsoleMessageLevel log_level,
                               const std::u16string& message,
--- a/content/shell/browser/shell.cc
+++ b/content/shell/browser/shell.cc
@@ -167,6 +167,17 @@
   NewWindowHandlerForEmbedder() = std::move(handler);
 }
 
+namespace {
+Shell::KeyboardEventHandler& KeyboardEventHandlerForEmbedder() {
+  static base::NoDestructor<Shell::KeyboardEventHandler> handler;
+  return *handler;
+}
+}  // namespace
+
+void Shell::SetKeyboardEventHandler(KeyboardEventHandler handler) {
+  KeyboardEventHandlerForEmbedder() = std::move(handler);
+}
+
 bool Shell::IsWebContentsCreationOverridden(
     RenderFrameHost* opener,
     SiteInstance* source_site_instance,
@@ -683,12 +694,20 @@
   g_platform->DidNavigatePrimaryMainFramePostCommit(
       this, WebContents::FromRenderFrameHost(&page.GetMainDocument()));
 }
+#endif
 
 bool Shell::HandleKeyboardEvent(WebContents* source,
                                 const input::NativeWebKeyboardEvent& event) {
+  if (const KeyboardEventHandler& handler = KeyboardEventHandlerForEmbedder();
+      handler && handler.Run(this, event)) {
+    return true;
+  }
+#if BUILDFLAG(IS_MAC)
   return g_platform->HandleKeyboardEvent(this, source, event);
-}
+#else
+  return false;
 #endif
