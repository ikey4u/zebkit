 namespace {
+Shell::PopupHandler& PopupHandlerForEmbedder() {
+  static base::NoDestructor<Shell::PopupHandler> handler;
+  return *handler;
+}
+}  // namespace
+
+void Shell::SetPopupHandler(PopupHandler handler) {
+  PopupHandlerForEmbedder() = std::move(handler);
+}
