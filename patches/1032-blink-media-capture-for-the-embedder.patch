+#ifndef THIRD_PARTY_BLINK_PUBLIC_PLATFORM_WEB_MEDIA_CAPTURE_H_
+#define THIRD_PARTY_BLINK_PUBLIC_PLATFORM_WEB_MEDIA_CAPTURE_H_
+
+#include <string>
+
+#include "base/memory/scoped_refptr.h"
+#include "base/time/time.h"
+
+namespace media {
+class DemuxerTap;
+}
+
+namespace blink {
+
+// A player's media as it is demuxed, for a copy made without decoding it
+// (WebMediaPlayer::GetMediaCapture()). On the main thread.
+class WebMediaCapture {
+ public:
+  struct Info {
+    // "file": a URL the player demuxes itself; "mse": Media Source
+    // Extensions, what the page appends; "hls": the player's own HLS.
+    std::string kind;
+    // media::GetCodecName()'s, "" for none or not known yet.
+    std::string audio_codec;
+    std::string video_codec;
+    // Encrypted Media Extensions: decrypted only by a CDM.
+    bool encrypted = false;
+  };
+
+  virtual Info GetCaptureInfo() const = 0;
+
+  // media::Demuxer::SetTap() on the player's demuxer. False when the player
+  // has none (nothing loaded, or media it does not demux).
+  virtual bool SetCaptureTap(scoped_refptr<media::DemuxerTap> tap,
+                             base::TimeDelta from) = 0;
+
+ protected:
+  virtual ~WebMediaCapture() = default;
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_PUBLIC_PLATFORM_WEB_MEDIA_CAPTURE_H_
