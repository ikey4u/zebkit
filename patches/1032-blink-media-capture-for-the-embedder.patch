+#include "third_party/blink/renderer/core/html/media/html_media_element.h"
+
+namespace blink {
+
+bool IsWebMediaElement(const WebElement& element) {
+  return !element.IsNull() &&
+         IsA<HTMLMediaElement>(*element.ConstUnwrap<Element>());
+}
+
+WebMediaPlayer* GetWebMediaPlayer(const WebElement& element) {
+  if (element.IsNull()) {
+    return nullptr;
+  }
+  const auto* media = DynamicTo<HTMLMediaElement>(*element.ConstUnwrap<Element>());
+  return media ? media->GetWebMediaPlayer() : nullptr;
+}
+
+}  // namespace blink
