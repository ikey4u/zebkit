+
+WebMediaCapture::Info WebMediaPlayerImpl::GetCaptureInfo() const {
+  DCHECK(main_task_runner_->BelongsToCurrentThread());
+  WebMediaCapture::Info info;
+  const std::optional<media::DemuxerType> type = GetDemuxerType();
+  if (type == media::DemuxerType::kManifestDemuxer) {
+    info.kind = "hls";
+  } else if (load_type_ == kLoadTypeMediaSource) {
+    info.kind = "mse";
+  } else {
+    info.kind = "file";
+  }
+  const media::AudioDecoderConfig& audio =
+      pipeline_metadata_.audio_decoder_config;
+  const media::VideoDecoderConfig& video =
+      pipeline_metadata_.video_decoder_config;
+  if (pipeline_metadata_.has_audio && audio.IsValidConfig()) {
+    info.audio_codec = media::GetCodecName(audio.codec());
+  }
+  if (pipeline_metadata_.has_video && video.IsValidConfig()) {
+    info.video_codec = media::GetCodecName(video.codec());
+  }
+  info.encrypted = is_encrypted_ ||
+                   (pipeline_metadata_.has_audio && audio.is_encrypted()) ||
+                   (pipeline_metadata_.has_video && video.is_encrypted());
+  return info;
+}
+
+bool WebMediaPlayerImpl::SetCaptureTap(scoped_refptr<media::DemuxerTap> tap,
+                                       base::TimeDelta from) {
+  DCHECK(main_task_runner_->BelongsToCurrentThread());
+  media::Demuxer* demuxer =
+      demuxer_manager_ ? demuxer_manager_->GetDemuxer() : nullptr;
+  if (!demuxer) {
+    return false;
+  }
+  demuxer->SetTap(std::move(tap), from);
+  return true;
+}
