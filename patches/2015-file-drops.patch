+ * @view: a #WPEView
+ * @phase: a #WPEFileDragPhase
+ * @x: the pointer's x, in view coordinates
+ * @y: the pointer's y, in view coordinates
+ * @uris: (nullable) (array zero-terminated=1): the URIs dropped
+ *
+ * zebkit: emit #WPEView::file-drag. Called by the platform.
+ *
+ * Returns: whether anything handles the signal: when nothing does, the
+ *    platform refuses the drag.
+ */
+gboolean wpe_view_file_drag(WPEView* view, WPEFileDragPhase phase, gdouble x, gdouble y, const char* const* uris)
+{
+    g_return_val_if_fail(WPE_IS_VIEW(view), FALSE);
+
+    if (!g_signal_has_handler_pending(view, signals[FILE_DRAG], 0, FALSE))
+        return FALSE;
+    g_signal_emit(view, signals[FILE_DRAG], 0, static_cast<guint>(phase), x, y, uris);
+    return TRUE;
+}
