+// The visible view of the toplevel a surface belongs to.
+static WPEView* viewForSurface(wl_surface* surface)
+{
+    auto* toplevel = surface ? wl_surface_get_user_data(surface) : nullptr;
+    if (!WPE_IS_TOPLEVEL(toplevel))
+        return nullptr;
+    WPEView* found = nullptr;
+    wpe_toplevel_foreach_view(WPE_TOPLEVEL(toplevel), [](WPEToplevel*, WPEView* view, gpointer data) -> gboolean {
+        if (!wpe_view_get_visible(view))
+            return FALSE;
+        *static_cast<WPEView**>(data) = view;
+        return TRUE;
+    }, &found);
+    return found;
