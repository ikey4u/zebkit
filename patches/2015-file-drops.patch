+    const auto* text = static_cast<const char*>(g_bytes_get_data(bytes.get(), &size));
+    GUniquePtr<char> list(g_strndup(text, size));
+    GUniquePtr<char*> uris(g_uri_list_extract_uris(list.get()));
+    wpe_view_file_drag(drop->view.get(), WPE_FILE_DRAG_DROP, drop->x, drop->y, uris.get());
+}
