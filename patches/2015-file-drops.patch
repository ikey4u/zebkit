+static void sendDndMessage(WPEDisplayX11Private* priv, Atom type, long l1, long l2, long l4)
+{
+    XEvent reply { };
+    reply.xclient.type = ClientMessage;
+    reply.xclient.display = priv->xdisplay;
+    reply.xclient.window = priv->dnd.source;
+    reply.xclient.message_type = type;
+    reply.xclient.format = 32;
+    reply.xclient.data.l[0] = priv->dnd.target;
+    reply.xclient.data.l[1] = l1;
+    reply.xclient.data.l[2] = l2;
+    reply.xclient.data.l[4] = l4;
+    XSendEvent(priv->xdisplay, priv->dnd.source, False, NoEventMask, &reply);
+    XFlush(priv->xdisplay);
+}
+
+static void endDnd(WPEDisplayX11Private* priv, bool notify)
+{
+    if (auto view = std::exchange(priv->dnd.view, nullptr); view && notify && priv->dnd.entered)
+        wpe_view_file_drag(view.get(), WPE_FILE_DRAG_LEAVE, 0, 0, nullptr);
+    priv->dnd.source = 0;
+    priv->dnd.target = 0;
+    priv->dnd.entered = false;
+}
+
+static bool dndOffersURIs(WPEDisplayX11Private* priv, const XClientMessageEvent& message)
+{
+    auto* xdisplay = priv->xdisplay;
+    // More than three types are in the source's XdndTypeList property.
+    if (!(message.data.l[1] & 1)) {
+        for (int i = 2; i <= 4; ++i) {
+            if (static_cast<Atom>(message.data.l[i]) == priv->dnd.uriList)
+                return true;
+        }
+        return false;
+    }
+    Atom type;
+    int format;
+    unsigned long count, remaining;
+    unsigned char* data = nullptr;
+    if (XGetWindowProperty(xdisplay, message.data.l[0], priv->dnd.typeList, 0, 1024, False, XA_ATOM, &type, &format, &count, &remaining, &data) || !data)
+        return false;
+    bool found = false;
+    for (unsigned long i = 0; i < count && !found; ++i)
+        found = reinterpret_cast<Atom*>(data)[i] == priv->dnd.uriList;
+    XFree(data);
+    return found;
+}
+
+// An XDND message to one of our windows. Returns false when it is not one.
+static bool handleDndMessage(WPEDisplayX11Private* priv, WPEToplevel* toplevel, WPEView* view, const XClientMessageEvent& message)
+{
+    auto& dnd = priv->dnd;
+    auto window = WPE_TOPLEVEL_X11(toplevel)->priv->window;
+    if (message.message_type == dnd.enter) {
+        endDnd(priv, true);
+        dnd.source = message.data.l[0];
+        dnd.target = window;
+        if (view && (message.data.l[1] >> 24) >= 2 && dndOffersURIs(priv, message))
+            dnd.view = view;
+        return true;
+    }
+    if (static_cast<Window>(message.data.l[0]) != dnd.source || !dnd.source)
+        return message.message_type == dnd.position || message.message_type == dnd.leave || message.message_type == dnd.drop;
+    if (message.message_type == dnd.position) {
+        long root = message.data.l[2];
+        int x, y;
+        Window child;
+        XTranslateCoordinates(priv->xdisplay, DefaultRootWindow(priv->xdisplay), window, root >> 16, root & 0xffff, &x, &y, &child);
+        dnd.x = x;
+        dnd.y = y;
+        if (dnd.view) {
+            if (wpe_view_file_drag(dnd.view.get(), dnd.entered ? WPE_FILE_DRAG_MOTION : WPE_FILE_DRAG_ENTER, x, y, nullptr))
+                dnd.entered = true;
+            else
+                dnd.view = nullptr;
+        }
+        // Accepted (bit 0), and positions wanted everywhere (bit 1).
+        sendDndMessage(priv, dnd.status, dnd.view ? 3 : 2, 0, dnd.view ? dnd.actionCopy : xNone);
+        return true;
+    }
+    if (message.message_type == dnd.leave) {
+        endDnd(priv, true);
+        return true;
+    }
+    if (message.message_type == dnd.drop) {
+        if (!dnd.view || !dnd.entered) {
+            sendDndMessage(priv, dnd.finished, 0, xNone, 0);
+            endDnd(priv, true);
+            return true;
+        }
+        // The answer is a SelectionNotify to the window.
+        XConvertSelection(priv->xdisplay, dnd.selection, dnd.uriList, dnd.property, window, message.data.l[2]);
+        XFlush(priv->xdisplay);
+        return true;
+    }
+    return false;
+}
+
+static void handleDndSelection(WPEDisplayX11Private* priv, const XSelectionEvent& event)
+{
+    auto& dnd = priv->dnd;
+    if (!dnd.view || event.requestor != dnd.target)
+        return;
+    GUniquePtr<char*> uris;
+    if (event.property != static_cast<Atom>(xNone)) {
+        Atom type;
+        int format;
+        unsigned long count, remaining;
+        unsigned char* data = nullptr;
+        if (!XGetWindowProperty(priv->xdisplay, event.requestor, event.property, 0, 1 << 24, True, AnyPropertyType, &type, &format, &count, &remaining, &data) && data) {
+            GUniquePtr<char> list(g_strndup(reinterpret_cast<const char*>(data), count * (format / 8)));
+            uris.reset(g_uri_list_extract_uris(list.get()));
+            XFree(data);
+        }
+    }
+    auto view = std::exchange(dnd.view, nullptr);
+    sendDndMessage(priv, dnd.finished, uris ? 1 : 0, uris ? dnd.actionCopy : xNone, 0);
+    if (uris)
+        wpe_view_file_drag(view.get(), WPE_FILE_DRAG_DROP, dnd.x, dnd.y, uris.get());
+    else
+        wpe_view_file_drag(view.get(), WPE_FILE_DRAG_LEAVE, 0, 0, nullptr);
+    endDnd(priv, false);
+}
