+static void dropRead(GObject* stream, GAsyncResult* result, gpointer data)
+{
+    std::unique_ptr<DropRead> drop(static_cast<DropRead*>(data));
+    bool read = g_output_stream_splice_finish(G_OUTPUT_STREAM(stream), result, nullptr) != -1;
+    if (wl_proxy_get_version(reinterpret_cast<wl_proxy*>(drop->offer)) >= 3)
+        wl_data_offer_finish(drop->offer);
+    wl_data_offer_destroy(drop->offer);
+    if (!read) {
+        wpe_view_file_drag(drop->view.get(), WPE_FILE_DRAG_LEAVE, 0, 0, nullptr);
+        return;
+    }
+
+    GRefPtr<GBytes> bytes = adoptGRef(g_memory_output_stream_steal_as_bytes(G_MEMORY_OUTPUT_STREAM(drop->output.get())));
