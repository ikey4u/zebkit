+// Copyright 2026 The zebkit Authors
+// zebkit: content/public/browser/zebkit_input.h.
+
+#include "content/public/browser/zebkit_input.h"
+
+#include "components/input/render_widget_host_input_event_router.h"
+#include "content/browser/renderer_host/render_widget_host_delegate.h"
+#include "content/browser/renderer_host/render_widget_host_impl.h"
+#include "content/browser/renderer_host/render_widget_host_view_base.h"
+#include "third_party/blink/public/common/input/web_mouse_event.h"
+#include "third_party/blink/public/common/input/web_mouse_wheel_event.h"
+#include "ui/latency/latency_info.h"
+
+namespace content {
+
+namespace {
+
+input::RenderWidgetHostInputEventRouter* RouterOf(RenderWidgetHostViewBase* view) {
+  RenderWidgetHostImpl* host = view ? view->host() : nullptr;
+  return host && host->delegate() ? host->delegate()->GetInputEventRouter()
+                                  : nullptr;
+}
+
+}  // namespace
+
+void RouteMouseEvent(RenderWidgetHostView* root,
+                     const blink::WebMouseEvent& event) {
+  auto* view = static_cast<RenderWidgetHostViewBase*>(root);
+  if (!view || !view->host())
+    return;
+  blink::WebMouseEvent routed = event;
+  if (auto* router = RouterOf(view)) {
+    router->RouteMouseEvent(view, &routed, ui::LatencyInfo());
+    return;
+  }
+  view->ProcessMouseEvent(routed, ui::LatencyInfo());
+}
+
+void RouteMouseWheelEvent(RenderWidgetHostView* root,
+                          const blink::WebMouseWheelEvent& event) {
+  auto* view = static_cast<RenderWidgetHostViewBase*>(root);
+  if (!view || !view->host())
+    return;
+  blink::WebMouseWheelEvent routed = event;
+  if (auto* router = RouterOf(view)) {
+    router->RouteMouseWheelEvent(view, &routed, ui::LatencyInfo());
+    return;
+  }
+  view->ProcessMouseWheelEvent(routed, ui::LatencyInfo());
+}
+
+RenderWidgetHost* GetFocusedRenderWidgetHost(RenderWidgetHost* widget) {
+  RenderWidgetHostImpl* host = RenderWidgetHostImpl::From(widget);
+  if (!host || !host->delegate())
+    return widget;
+  RenderWidgetHostImpl* focused =
+      host->delegate()->GetFocusedRenderWidgetHost(host);
+  return focused ? focused : widget;
+}
+
+}  // namespace content
