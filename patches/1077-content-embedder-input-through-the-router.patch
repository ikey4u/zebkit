@@ -0,0 +1,41 @@
+// Copyright 2026 The zebkit Authors
+// zebkit: input an embedder makes itself (off-screen rendering) to a page's
+// widgets as the platform's events reach them in a window: through the
+// WebContents' input event router, which finds the frame under the mouse,
+// a frame of another site's included, keeps a pressed button's frame until
+// it is released, sends mouseenter and mouseleave between frames, and keeps
+// a scroll gesture on the frame it began in; and keys to the focused frame's
+// widget.
+
+#ifndef CONTENT_PUBLIC_BROWSER_ZEBKIT_INPUT_H_
+#define CONTENT_PUBLIC_BROWSER_ZEBKIT_INPUT_H_
+
+#include "content/common/content_export.h"
+
+namespace blink {
+class WebMouseEvent;
+class WebMouseWheelEvent;
+}  // namespace blink
+
+namespace content {
+
+class RenderWidgetHost;
+class RenderWidgetHostView;
+
+// @event, in @root's coordinates, to the widget under it, as
+// RenderWidgetHostViewAura and RenderWidgetHostViewMac send the platform's.
+// @root is a page's main view (or a popup's). Straight to @root's widget
+// where nothing routes.
+CONTENT_EXPORT void RouteMouseEvent(RenderWidgetHostView* root,
+                                    const blink::WebMouseEvent& event);
+CONTENT_EXPORT void RouteMouseWheelEvent(RenderWidgetHostView* root,
+                                         const blink::WebMouseWheelEvent& event);
+
+// The widget keys sent to @widget's page go to: the focused frame's
+// (RenderWidgetHostDelegate::GetFocusedRenderWidgetHost()), else @widget.
+CONTENT_EXPORT RenderWidgetHost* GetFocusedRenderWidgetHost(
+    RenderWidgetHost* widget);
+
+}  // namespace content
+
+#endif  // CONTENT_PUBLIC_BROWSER_ZEBKIT_INPUT_H_
