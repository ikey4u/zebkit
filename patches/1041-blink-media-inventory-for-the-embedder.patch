+std::vector<WebElement> GetWebMediaElements(const WebDocument& document) {
+  std::vector<WebElement> result;
+  if (document.IsNull())
+    return result;
+  WebDocument owner = document;
+  auto it = DocumentToElementSetMap().find(owner.Unwrap<Document>());
+  if (it == DocumentToElementSetMap().end())
+    return result;
+  for (const auto& element : *it->value) {
+    if (element)
+      result.emplace_back(element.Get());
+  }
+  return result;
+}
