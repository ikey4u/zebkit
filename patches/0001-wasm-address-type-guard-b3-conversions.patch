Build fix: the B3 conversions in Wasm::AddressType were guarded by
ENABLE(JIT), but B3::Type only exists when B3 or the BBQ JIT is built.
With FTL and both WebAssembly JIT tiers off, B3Type.h is empty and the file
fails to compile. Use the same guard B3Type.h uses. No size effect.

--- a/Source/JavaScriptCore/wasm/WasmAddressType.h
+++ b/Source/JavaScriptCore/wasm/WasmAddressType.h
@@ -46,7 +46,7 @@
     AddressType() = default;
     AddressType(TypeKind);
     AddressType(AddressType::Kind);
-#if !PLATFORM(PLAYSTATION) && ENABLE(JIT)
+#if !PLATFORM(PLAYSTATION) && (ENABLE(B3_JIT) || ENABLE(WEBASSEMBLY_BBQJIT))
     AddressType(B3::Type);
 #endif
     explicit AddressType(bool is64bit);
--- a/Source/JavaScriptCore/wasm/WasmAddressType.cpp
+++ b/Source/JavaScriptCore/wasm/WasmAddressType.cpp
@@ -52,7 +52,7 @@
     }
 }
 
