+// Copyright 2026 The zebkit Authors
+// zebkit: whose a WebSocket is when it has no frame. ContentBrowserClient's
+// WillInterceptWebSocket() and CreateWebSocket() are given a null frame for a
+// shared or service worker's socket, and nothing else of the worker: an
+// embedder with a policy per BrowserContext cannot tell which applies.
+
+#ifndef CONTENT_PUBLIC_BROWSER_ZEBKIT_WEBSOCKET_H_
+#define CONTENT_PUBLIC_BROWSER_ZEBKIT_WEBSOCKET_H_
+
+#include <optional>
+
+#include "base/unguessable_token.h"
+#include "content/common/content_export.h"
+#include "content/public/common/child_process_id.h"
+
+namespace content {
+
+struct WebSocketInitiator {
+  // The process that asked for the socket: RenderProcessHost::FromID().
+  ChildProcessId process_id;
+  // A worker's DevTools token (a dedicated worker's too); for a shared or
+  // service worker, the id of its DevToolsAgentHost:
+  // DevToolsAgentHost::GetForId(token.ToString()), of type "shared_worker" or
+  // "service_worker". nullopt for a frame's socket.
+  std::optional<base::UnguessableToken> devtools_worker_token;
+};
+
+// The socket being created, during the embedder's GetWebSocketOptions(),
+// WillInterceptWebSocket() and CreateWebSocket() for it; nullptr at any other
+// time. UI thread only.
+CONTENT_EXPORT const WebSocketInitiator* CurrentWebSocketInitiator();
+
+}  // namespace content
+
+#endif  // CONTENT_PUBLIC_BROWSER_ZEBKIT_WEBSOCKET_H_
