zebkit: build the Chrome DevTools Protocol endpoint into the library

The endpoint's sources are zebkit's own and live in src/cdp, outside this
tree; the profile passes their location as ZEBKIT_CDP_DIR. This patch is
the two places WebKit has to know about them: the build adds the sources to
libWPEWebKit, and WebKitWebView tells the endpoint about every view that is
created and destroyed, since each view is a page a CDP client can drive.

--- a/Source/WebKit/PlatformWPE.cmake
+++ b/Source/WebKit/PlatformWPE.cmake
@@ -824,3 +824,12 @@
     NO_IMPLICIT_SOURCES
 )
 GI_DOCGEN(${WPE_WEB_PROCESS_EXTENSION_API_NAME} wpe/wpe-web-process-extension.toml.in)
+
+# zebkit: the Chrome DevTools Protocol endpoint, built from sources that live
+# outside this tree.
+if (ZEBKIT_CDP_DIR)
+    file(GLOB ZEBKIT_CDP_SOURCES CONFIGURE_DEPENDS "${ZEBKIT_CDP_DIR}/*.cpp")
+    list(APPEND WebKit_SOURCES ${ZEBKIT_CDP_SOURCES})
+    list(APPEND WebKit_PRIVATE_INCLUDE_DIRECTORIES "${ZEBKIT_CDP_DIR}")
+    add_definitions(-DENABLE_ZEBKIT_CDP=1)
+endif ()
--- a/Source/WebKit/UIProcess/API/glib/WebKitWebView.cpp
+++ b/Source/WebKit/UIProcess/API/glib/WebKitWebView.cpp
@@ -71,6 +71,10 @@
 #include "WebKitWebResourcePrivate.h"
 #include "WebKitWebViewInternal.h"
 #include "WebKitWebViewPrivate.h"
+
+#if ENABLE(ZEBKIT_CDP)
+#include "CDP.h"
+#endif
 #include "WebKitWebViewSessionStatePrivate.h"
 #include "WebKitWebsiteDataManagerPrivate.h"
 #include "WebKitWebsitePoliciesPrivate.h"
@@ -1059,6 +1063,10 @@
     priv->backForwardList = adoptGRef(webkitBackForwardListCreate(&getPage(webView).backForwardListWrapper()));
     priv->windowProperties = adoptGRef(webkitWindowPropertiesCreate());
     priv->isWebProcessResponsive = true;
+
+#if ENABLE(ZEBKIT_CDP)
+    Zebkit::CDP::webViewCreated(webView);
+#endif
 }
 
 static void webkitWebViewSetProperty(GObject* object, guint propId, const GValue* value, GParamSpec* paramSpec)
@@ -1286,6 +1294,10 @@
 {
     WebKitWebView* webView = WEBKIT_WEB_VIEW(object);
 
+#if ENABLE(ZEBKIT_CDP)
+    Zebkit::CDP::webViewDestroyed(webView);
+#endif
+
 #if PLATFORM(GTK)
     webkitWebViewCancelFaviconRequest(webView);
     webView->priv->faviconChangedHandlerID = 0;
