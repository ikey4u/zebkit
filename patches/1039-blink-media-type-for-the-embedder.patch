+// Copyright 2026 The zebkit Authors
+// zebkit: the media a page's CSS is for, as DevTools' Emulation domain sets
+// it (setEmulatedMedia), for the embedder's automation.
+
+#ifndef THIRD_PARTY_BLINK_PUBLIC_WEB_WEB_MEDIA_EMULATION_H_
+#define THIRD_PARTY_BLINK_PUBLIC_WEB_WEB_MEDIA_EMULATION_H_
+
+#include "third_party/blink/public/platform/web_common.h"
+#include "third_party/blink/public/platform/web_string.h"
+
+namespace blink {
+
+class WebView;
+
+// "print", "screen", or empty for the page's own.
+BLINK_EXPORT void SetMediaTypeOverride(WebView* view, const WebString& media);
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_PUBLIC_WEB_WEB_MEDIA_EMULATION_H_
--- /dev/null
+++ b/third_party/blink/renderer/core/exported/web_media_emulation.cc
@@ -0,0 +1,17 @@
+// Copyright 2026 The zebkit Authors
+// zebkit: third_party/blink/public/web/web_media_emulation.h.
+
+#include "third_party/blink/public/web/web_media_emulation.h"
+
+#include "third_party/blink/renderer/core/exported/web_view_impl.h"
+#include "third_party/blink/renderer/core/frame/settings.h"
+#include "third_party/blink/renderer/core/page/page.h"
+
+namespace blink {
+
+void SetMediaTypeOverride(WebView* view, const WebString& media) {
+  if (Page* page = static_cast<WebViewImpl*>(view)->GetPage())
+    page->GetSettings().SetMediaTypeOverride(media);
+}
+
+}  // namespace blink
