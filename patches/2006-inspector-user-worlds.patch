-Inspector::Protocol::ErrorStringOr<void> InspectorPageAgent::setBootstrapScript(const String& source)
+Inspector::Protocol::ErrorStringOr<void> InspectorPageAgent::setBootstrapScript(const String& source, const String& worldName)
 {
-    m_bootstrapScript = source;
+    if (worldName.isEmpty()) {
+        m_bootstrapScript = source;
+        return { };
+    }
+
+    // zebkit: a named user world, with its own script.
+    if (auto iterator = m_userWorlds.find(worldName); iterator != m_userWorlds.end()) {
+        iterator->value->bootstrapScript = source;
+        return { };
+    }
+
+    auto& userWorld = *m_userWorlds.add(worldName, makeUniqueWithoutFastMallocCheck<UserWorld>(ScriptController::createWorld(worldName, ScriptController::WorldType::User), source)).iterator->value;
+    // The documents that are already there get the world but not the script,
+    // which is for global objects created from now on.
+    protect(m_inspectedPage)->forEachLocalFrame([&](LocalFrame& frame) {
+        ensureUserWorld(frame, userWorld, false);
+    });
 
     return { };
 }
 
+void InspectorPageAgent::ensureUserWorld(LocalFrame& frame, UserWorld& userWorld, bool runBootstrapScript)
+{
+    if (!frame.script().canExecuteScripts(ReasonForCallingCanExecuteScripts::NotAboutToExecuteScript))
+        return;
+
+    RefPtr window = frame.window();
+    if (!window)
+        return;
+
+    if (!runBootstrapScript)
+        userWorld.windows.add(*window);
+
+    // Creating the global object reports it through didClearWindowObjectInWorld().
+    Ref world = userWorld.world;
+    frame.script().globalObject(world);
+}
