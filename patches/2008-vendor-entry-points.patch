zebkit: let applications use the libraries linked into the engine

The engine has whole libraries linked into it statically (FFmpeg first of
all). An application that needs one of them would ship a second copy. With
this, it uses the engine's.

scripts/gen-vendor.py generates, outside this tree, one small source file
per library: an exported entry point zebkit_vendor_<library>_<function> for
every function of the library's public API, each a jump to the function
itself. The profile passes the directory as ZEBKIT_VENDOR_DIR. This patch
adds those sources to the library and their prefix to the list of what the
library exports. The libraries' own names stay unexported, so a process
that also loads another copy of one of them has two that cannot collide.

--- a/Source/WebKit/PlatformWPE.cmake
+++ b/Source/WebKit/PlatformWPE.cmake
@@ -835,3 +835,10 @@
     list(APPEND WebKit_PRIVATE_INCLUDE_DIRECTORIES "${ZEBKIT_CDP_DIR}")
     add_definitions(-DENABLE_ZEBKIT_CDP=1)
 endif ()
+
+# zebkit: entry points through which applications use libraries that are
+# linked into the engine. The sources are generated outside this tree.
+if (ZEBKIT_VENDOR_DIR)
+    file(GLOB ZEBKIT_VENDOR_SOURCES CONFIGURE_DEPENDS "${ZEBKIT_VENDOR_DIR}/*.cpp")
+    list(APPEND WebKit_SOURCES ${ZEBKIT_VENDOR_SOURCES})
+endif ()
--- a/Source/WebKit/webkitglib-symbols.map
+++ b/Source/WebKit/webkitglib-symbols.map
@@ -4,6 +4,7 @@
   webkit_*;
   wpe_*;
   zebkit_cdp_*;
+  zebkit_vendor_*;
   extern "C++" {
     "WebKit::GPUProcessMain(int, char**)";
     "WebKit::NetworkProcessMain(int, char**)";
