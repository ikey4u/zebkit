+// static
+DirectHandle<Object> ErrorUtils::GetStackForInspector(
+    Isolate* isolate, DirectHandle<JSObject> maybe_error_object) {
+  ErrorUtils::StackPropertyLookupResult lookup =
+      ErrorUtils::GetErrorStackProperty(isolate, maybe_error_object);
+  Handle<FixedArray> raw_data;
+  if (IsErrorStackData(*lookup.error_stack)) {
+    auto error_stack_data = Cast<ErrorStackData>(lookup.error_stack);
+    if (error_stack_data->HasFormattedStack()) {
+      return direct_handle(error_stack_data->formatted_stack(), isolate);
+    }
+    raw_data =
+        handle(error_stack_data->raw_data_for_call_site_infos(), isolate);
+  } else if (IsFixedArray(*lookup.error_stack)) {
+    raw_data = handle(Cast<FixedArray>(*lookup.error_stack), isolate);
+  } else {
+    return lookup.error_stack;
+  }
+
+  Handle<FixedArray> expanded =
+      CallSiteInfo::ExpandDeferredFrames(isolate, raw_data);
+  IncrementalStringBuilder builder(isolate);
+  uint32_t elems_len =
+      expanded->ulength().value() / CallSiteInfo::Fields::kCount;
+  v8::TryCatch try_catch(reinterpret_cast<v8::Isolate*>(isolate));
+  for (uint32_t i = 0; i < elems_len; ++i) {
+    builder.AppendCStringLiteral("\n    at ");
+    DirectHandle<CallSiteInfo> frame =
+        CallSiteInfo::ConstructFromRawData(isolate, expanded, i);
+    SerializeCallSiteInfo(isolate, frame, &builder);
+    if (isolate->has_exception()) {
+      try_catch.Reset();
+      return isolate->factory()->undefined_value();
+    }
+  }
+  DirectHandle<String> frames;
+  if (!builder.Finish().ToHandle(&frames)) {
+    try_catch.Reset();
+    return isolate->factory()->undefined_value();
+  }
+  return frames;
+}
