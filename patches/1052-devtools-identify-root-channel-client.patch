@@ -37,6 +37,11 @@
   // The client to which the messages will be dispatched.
   virtual DevToolsAgentHostClient* GetClient() = 0;
 
+  // The outermost client when this channel represents a flattened child
+  // session. Embedders can distinguish their own clients from external ones
+  // without depending on the implementation of intermediate target sessions.
+  virtual DevToolsAgentHostClient* GetRootClient();
+
   virtual ~DevToolsAgentHostClientChannel() = default;
 };
 
