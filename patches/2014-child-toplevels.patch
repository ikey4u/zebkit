+static WPEToplevel* wpeToplevelWaylandCreateChild(WPEToplevel* parent)
+{
+    return WPE_TOPLEVEL(g_object_new(WPE_TYPE_TOPLEVEL_WAYLAND, "display", wpe_toplevel_get_display(parent), "max-views", 1, "parent", parent, nullptr));
