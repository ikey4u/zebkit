+
+// Subsurface position and stacking take effect when the parent commits.
+static void wpeToplevelWaylandCommitParent(WPEToplevel* toplevel)
+{
+    auto* parent = wpe_toplevel_get_parent(toplevel);
+    if (parent && WPE_IS_TOPLEVEL_WAYLAND(parent))
+        wl_surface_commit(WPE_TOPLEVEL_WAYLAND(parent)->priv->wlSurface);
+}
+
+static void wpeToplevelWaylandSetChildGeometry(WPEToplevel* toplevel, int x, int y, int width, int height)
+{
+    auto* priv = WPE_TOPLEVEL_WAYLAND(toplevel)->priv;
+    if (!priv->wlSubsurface)
+        return;
+
+    wl_subsurface_set_position(priv->wlSubsurface, x, y);
+    wpeToplevelWaylandCommitParent(toplevel);
+    int currentWidth, currentHeight;
+    wpe_toplevel_get_size(toplevel, &currentWidth, &currentHeight);
+    if (currentWidth != width || currentHeight != height)
+        wpeToplevelWaylandResized(toplevel, width, height);
+}
+
+static WPEToplevelWayland* wpeToplevelWaylandRoot(WPEToplevelWayland*);
+static void wpeToplevelWaylandSetFocusedChild(WPEToplevelWayland* root, WPEToplevel* child);
+
+static void wpeToplevelWaylandSetChildVisible(WPEToplevel* toplevel, gboolean visible)
+{
+    auto* priv = WPE_TOPLEVEL_WAYLAND(toplevel)->priv;
+    if (!priv->wlSubsurface || priv->childVisible == !!visible)
+        return;
+
+    // A hidden child stays mapped below its parent: unmapped, its frame
+    // callbacks would never come back and rendering would stall.
+    auto* parentSurface = WPE_TOPLEVEL_WAYLAND(wpe_toplevel_get_parent(toplevel))->priv->wlSurface;
+    if (visible)
+        wl_subsurface_place_above(priv->wlSubsurface, parentSurface);
+    else
+        wl_subsurface_place_below(priv->wlSubsurface, parentSurface);
+    priv->childVisible = visible;
+    wpeToplevelWaylandCommitParent(toplevel);
+
+    auto* root = wpeToplevelWaylandRoot(WPE_TOPLEVEL_WAYLAND(toplevel));
+    if (!visible && root->priv->focusedChild.get() == toplevel)
+        wpeToplevelWaylandSetFocusedChild(root, nullptr);
+}
