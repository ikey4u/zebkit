+// zebkit: the window a child toplevel is in.
+static WPEToplevelWayland* wpeToplevelWaylandRoot(WPEToplevelWayland* toplevel)
+{
+    while (auto* parent = wpe_toplevel_get_parent(WPE_TOPLEVEL(toplevel))) {
+        if (!WPE_IS_TOPLEVEL_WAYLAND(parent))
+            break;
+        toplevel = WPE_TOPLEVEL_WAYLAND(parent);
+    }
+    return toplevel;
+}
+
+// zebkit: the view of the child that has the keyboard, if it is shown.
+static WPEView* wpeToplevelWaylandFocusedChildView(WPEToplevelWayland* root)
+{
+    auto* child = root->priv->focusedChild.get();
+    if (!child || !WPE_IS_TOPLEVEL_WAYLAND(child) || !WPE_TOPLEVEL_WAYLAND(child)->priv->childVisible)
+        return nullptr;
+    return wpeToplevelWaylandFindVisibleView(WPE_TOPLEVEL_WAYLAND(child));
+}
+
+static void wpeToplevelWaylandSetFocusedChild(WPEToplevelWayland* root, WPEToplevel* child)
+{
+    if (root->priv->focusedChild.get() == child)
+        return;
+    GRefPtr<WPEView> before = wpeToplevelWaylandGetVisibleFocusedView(root);
+    root->priv->focusedChild.reset(child);
+    GRefPtr<WPEView> after = wpeToplevelWaylandGetVisibleFocusedView(root);
+    if (before == after)
+        return;
+    if (before)
+        wpe_view_focus_out(before.get());
+    if (after)
+        wpe_view_focus_in(after.get());
+}
+
+// zebkit: a press gives the keyboard to the child pressed, or back to the
+// window when the press is outside its children. Wayland sends keyboard
+// focus to the window's surface only, never to a subsurface.
+void wpeToplevelWaylandPointerPressed(WPEToplevelWayland* toplevel)
+{
+    auto* root = wpeToplevelWaylandRoot(toplevel);
+    wpeToplevelWaylandSetFocusedChild(root, root == toplevel ? nullptr : WPE_TOPLEVEL(toplevel));
+}
