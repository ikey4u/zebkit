+/**
+ * wpe_toplevel_new_child:
+ * @parent: a #WPEToplevel
+ *
+ * zebkit: create a toplevel drawn inside @parent, above @parent's view, at
+ * the rectangle set with wpe_toplevel_set_child_geometry(). Pointer input
+ * over it goes to its view; keyboard input goes to it after it was
+ * clicked. A view is put into it with wpe_view_set_toplevel().
+ *
+ * On a platform that cannot draw one window inside another (headless), the
+ * child is a toplevel of its own that follows the size it is given.
+ *
+ * Returns: (transfer full): a new #WPEToplevel
+ */
+WPEToplevel* wpe_toplevel_new_child(WPEToplevel* parent)
+{
+    g_return_val_if_fail(WPE_IS_TOPLEVEL(parent), nullptr);
+
+    auto* toplevelClass = WPE_TOPLEVEL_GET_CLASS(parent);
+    if (toplevelClass->create_child)
+        return toplevelClass->create_child(parent);
+
+    auto* display = wpe_toplevel_get_display(parent);
+    auto* toplevel = display ? wpe_display_create_toplevel(display, 1) : nullptr;
+    if (toplevel)
+        toplevel->priv->parent = parent;
+    return toplevel;
+}
+
+/**
+ * wpe_toplevel_get_parent:
+ * @toplevel: a #WPEToplevel
+ *
+ * zebkit: the toplevel @toplevel is drawn inside.
+ *
+ * Returns: (transfer none) (nullable): the parent, or %NULL
+ */
+WPEToplevel* wpe_toplevel_get_parent(WPEToplevel* toplevel)
+{
+    g_return_val_if_fail(WPE_IS_TOPLEVEL(toplevel), nullptr);
+
+    return toplevel->priv->parent.get();
+}
+
+/**
+ * wpe_toplevel_set_child_geometry:
+ * @toplevel: a child #WPEToplevel
+ * @x: left edge, in the parent's logical coordinates
+ * @y: top edge, in the parent's logical coordinates
+ * @width: width
+ * @height: height
+ *
+ * zebkit: place a child toplevel inside its parent and size it.
+ */
+void wpe_toplevel_set_child_geometry(WPEToplevel* toplevel, int x, int y, int width, int height)
+{
+    g_return_if_fail(WPE_IS_TOPLEVEL(toplevel));
+    g_return_if_fail(width > 0 && height > 0);
+
+    auto* toplevelClass = WPE_TOPLEVEL_GET_CLASS(toplevel);
+    if (toplevelClass->set_child_geometry && toplevel->priv->parent) {
+        toplevelClass->set_child_geometry(toplevel, x, y, width, height);
+        return;
+    }
+    if (!wpe_toplevel_resize(toplevel, width, height)) {
+        wpe_toplevel_resized(toplevel, width, height);
+        wpe_toplevel_foreach_view(toplevel, [](WPEToplevel* toplevel, WPEView* view, gpointer) -> gboolean {
+            int width, height;
+            wpe_toplevel_get_size(toplevel, &width, &height);
+            wpe_view_resized(view, width, height);
+            return FALSE;
+        }, nullptr);
+    }
+}
+
+/**
+ * wpe_toplevel_set_child_visible:
+ * @toplevel: a child #WPEToplevel
+ * @visible: whether it is shown
+ *
+ * zebkit: show or hide a child toplevel. A hidden one takes no input. Its
+ * views' own visibility (wpe_view_set_visible()) is the caller's to set.
+ */
+void wpe_toplevel_set_child_visible(WPEToplevel* toplevel, gboolean visible)
+{
+    g_return_if_fail(WPE_IS_TOPLEVEL(toplevel));
+
+    auto* toplevelClass = WPE_TOPLEVEL_GET_CLASS(toplevel);
+    if (toplevelClass->set_child_visible && toplevel->priv->parent)
+        toplevelClass->set_child_visible(toplevel, visible);
+}
