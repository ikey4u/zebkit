@@ -0,0 +1,28 @@
+// Copyright 2026 The zebkit Authors
+// zebkit: which DevTools clients hold the hang monitor. A renderer that does
+// not answer input is not reported unresponsive while a debugger is attached
+// to its page (it may sit on a breakpoint), and upstream counts every DevTools
+// client as one: an embedder that drives its own pages through DevTools
+// sessions would never be told of a hang.
+
+#ifndef CONTENT_PUBLIC_BROWSER_ZEBKIT_HANG_MONITOR_H_
+#define CONTENT_PUBLIC_BROWSER_ZEBKIT_HANG_MONITOR_H_
+
+#include "content/common/content_export.h"
+
+namespace content {
+
+class WebContents;
+
+// Whether a debugger is attached to |contents|, for the hang monitor only.
+using DebuggerAttachedForHangsFunction = bool (*)(WebContents* contents);
+
+// Asked instead of DevToolsAgentHost::IsDebuggerAttached() when set (nullptr:
+// upstream's answer). The Windows check for a native debugger of the renderer
+// stays. UI thread only.
+CONTENT_EXPORT void SetDebuggerAttachedForHangs(
+    DebuggerAttachedForHangsFunction function);
+
+}  // namespace content
+
+#endif  // CONTENT_PUBLIC_BROWSER_ZEBKIT_HANG_MONITOR_H_
