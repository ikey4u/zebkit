+// The video the decoders took since the last keyframe: a tap starts there,
+// so that it has a keyframe for what is shown now. Up to kTapHistory
+// bytes; a longer group of pictures is not kept. Only once taps may come
+// (DemuxerTap::KeepsForTaps()): until then players keep nothing.
+void FFmpegDemuxerStream::KeepForTap(const scoped_refptr<DecoderBuffer>& buffer) {
+  constexpr size_t kTapHistory = 16 * 1024 * 1024;
+  if (type_ != VIDEO || buffer->end_of_stream() ||
+      !DemuxerTap::KeepsForTaps()) {
+    return;
+  }
+  if (buffer->is_key_frame()) {
+    taken_.clear();
+    taken_bytes_ = 0;
+  } else if (taken_.empty()) {
+    return;
+  }
+  taken_bytes_ += buffer->size();
+  if (taken_bytes_ > kTapHistory) {
+    taken_.clear();
+    taken_bytes_ = 0;
+    return;
+  }
+  taken_.push_back(buffer);
+}
+
+void FFmpegDemuxerStream::StartTap(DemuxerTap* tap) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  tapped_ = tap;
+  if (type_ == AUDIO && audio_config_) {
+    tap->OnAudioConfig(this, *audio_config_);
+  } else if (type_ == VIDEO && video_config_) {
+    tap->OnVideoConfig(this, *video_config_);
+  } else {
+    return;
+  }
+  for (const auto& buffer : taken_) {
+    tap->OnBuffer(this, buffer, kNoTimestamp);
+  }
+  buffer_queue_.ForEach([&](const scoped_refptr<DecoderBuffer>& buffer) {
+    tap->OnBuffer(this, buffer, kNoTimestamp);
+  });
+}
