+void ChunkDemuxerStream::SetTap(scoped_refptr<DemuxerTap> tap,
+                                base::TimeDelta from) {
+  base::AutoLock auto_lock(lock_);
+  tap_ = std::move(tap);
+  tapped_config_id_ = -1;
+  if (tap_ && stream_) {
+    stream_->ForEachBuffer(
+        from, [&](const scoped_refptr<StreamParserBuffer>& buffer) {
+          lock_.AssertAcquired();
+          TapBuffer_Locked(buffer);
+        });
+  }
+}
+
+void ChunkDemuxerStream::TapBuffer_Locked(
+    const scoped_refptr<StreamParserBuffer>& buffer) {
+  const int config_id = buffer->GetConfigId();
+  if (config_id != tapped_config_id_) {
+    if (type_ == AUDIO) {
+      const AudioDecoderConfig* config = stream_->GetAudioConfigForId(config_id);
+      if (!config) {
+        return;
+      }
+      tap_->OnAudioConfig(this, *config);
+    } else if (type_ == VIDEO) {
+      const VideoDecoderConfig* config = stream_->GetVideoConfigForId(config_id);
+      if (!config) {
+        return;
+      }
+      tap_->OnVideoConfig(this, *config);
+    } else {
+      return;
+    }
+    tapped_config_id_ = config_id;
+  }
+  tap_->OnBuffer(this, buffer,
+                 buffer->GetDecodeTimestamp().ToPresentationTime());
+}
