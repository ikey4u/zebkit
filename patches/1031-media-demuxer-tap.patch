+namespace media {
+
+class AudioDecoderConfig;
+class DecoderBuffer;
+class VideoDecoderConfig;
+
+// What a demuxer gives its decoders, as it has it: each stream's
+// configuration and its encoded buffers, in decode order, for a copy of
+// the media made without decoding it (Demuxer::SetTap()). A stream's
+// configuration always comes before its buffers, and again when it
+// changes. Called on whichever thread the demuxer works on (the media
+// thread, or the main thread for what a page appends to a SourceBuffer),
+// so the implementation must take what it needs and return.
+class MEDIA_EXPORT DemuxerTap
+    : public base::RefCountedThreadSafe<DemuxerTap> {
+ public:
+  DemuxerTap() = default;
+  DemuxerTap(const DemuxerTap&) = delete;
+  DemuxerTap& operator=(const DemuxerTap&) = delete;
+
+  // |stream| tells the streams apart; it is not to be called.
+  virtual void OnAudioConfig(const void* stream,
+                             const AudioDecoderConfig& config) = 0;
+  virtual void OnVideoConfig(const void* stream,
+                             const VideoDecoderConfig& config) = 0;
+  // |decode_timestamp| is kNoTimestamp when the demuxer does not know it
+  // (it is the presentation timestamp for audio).
+  virtual void OnBuffer(const void* stream,
+                        scoped_refptr<DecoderBuffer> buffer,
+                        base::TimeDelta decode_timestamp) = 0;
+  // The demuxer stopped: nothing follows.
+  virtual void OnStopped() = 0;
+
+  // Taps may come in this process (the embedder looks for media to copy):
+  // from now on demuxers keep what a tap would start from that they do not
+  // hold anyway (FFmpegDemuxer: the video its decoders took since the last
+  // keyframe). Until then they keep nothing for a tap. Any thread.
+  static void KeepForTapsFromNow();
+  static bool KeepsForTaps();
+
+ protected:
+  friend class base::RefCountedThreadSafe<DemuxerTap>;
+  virtual ~DemuxerTap() = default;
+};
+
+}  // namespace media
+
+#endif  // MEDIA_BASE_DEMUXER_TAP_H_
