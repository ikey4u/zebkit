+void SourceBufferStream::ForEachBuffer(
+    base::TimeDelta from,
+    base::FunctionRef<void(const scoped_refptr<StreamParserBuffer>&)> f)
+    const {
+  for (const auto& range : ranges_) {
+    if (from != kNoTimestamp && range->GetBufferedEndTimestamp() <= from) {
+      continue;
+    }
+    const SourceBufferRange::BufferQueue& buffers = range->buffers();
+    size_t start = 0;
+    if (from != kNoTimestamp) {
+      for (size_t i = 0; i < buffers.size(); ++i) {
+        if (buffers[i]->timestamp() > from) {
+          break;
+        }
+        if (buffers[i]->is_key_frame()) {
+          start = i;
+        }
+      }
+    }
+    for (size_t i = start; i < buffers.size(); ++i) {
+      f(buffers[i]);
+    }
+  }
+}
