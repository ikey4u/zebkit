-
-  metadata.bitness = embedder_support::GetCpuBitness();
-  metadata.wow64 = embedder_support::IsWoW64();
-  metadata.form_factors = {"Desktop"};
-
-  return metadata;
+  // zebkit: what Chromium of this version tells sites (brands with GREASE,
+  // the real version and platform), not "content_shell" 999 on "Unknown".
+  return embedder_support::GetUserAgentMetadata();
 }
 
