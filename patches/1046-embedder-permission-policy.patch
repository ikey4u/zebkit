+void SetEmbedderPermissionHooks(EmbedderPermissionStatusHook status,
+                                EmbedderPermissionChangedHook changed) {
+  PermissionHooks().status = std::move(status);
+  PermissionHooks().changed = std::move(changed);
+}
+void UpdateEmbedderPermissionState(BrowserContext* context, base::OnceClosure update) {
+  if (context) PermissionControllerImpl::FromBrowserContext(context)->UpdateEmbedderState(std::move(update));
+}
+std::optional<PermissionStatus> GetEmbedderContextPermissionOverride(
+    BrowserContext* context, const url::Origin& requesting,
+    const url::Origin& embedding, PermissionType type) {
+  return context ? PermissionControllerImpl::FromBrowserContext(context)->GetEmbedderContextOverride(
+                       requesting, embedding, type) : std::nullopt;
+}
+void GrantEmbedderContextPermissions(BrowserContext* context,
+    const std::optional<url::Origin>& origin, const std::vector<PermissionType>& permissions,
+    base::OnceCallback<void(bool)> done) {
+  if (!context) { std::move(done).Run(false); return; }
+  base::optional_ref<const url::Origin> reference = origin
+      ? base::optional_ref<const url::Origin>(*origin) : base::optional_ref<const url::Origin>();
+  auto* controller = PermissionControllerImpl::FromBrowserContext(context);
+  std::vector<PermissionType> merged = permissions;
+  for (auto type : blink::GetAllPermissionTypes()) {
+    if (type == PermissionType::GEOLOCATION_APPROXIMATE) continue;
+    auto prior = controller->GetExactEmbedderContextOverride(reference, reference, type);
+    if (prior == PermissionStatus::GRANTED && std::ranges::find(merged, type) == merged.end())
+      merged.push_back(type);
+  }
+  if (std::ranges::find(merged, PermissionType::MIDI_SYSEX) != merged.end() &&
+      std::ranges::find(merged, PermissionType::MIDI) == merged.end()) merged.push_back(PermissionType::MIDI);
+  controller->GrantPermissionOverrides(
+      reference, reference, merged,
+      base::BindOnce([](base::OnceCallback<void(bool)> callback,
+                        PermissionControllerImpl::OverrideStatus status) {
+        std::move(callback).Run(status == PermissionControllerImpl::OverrideStatus::kOverrideSet);
+      }, std::move(done)));
+}
+void ResetEmbedderContextPermissions(BrowserContext* context, base::OnceClosure done) {
+  if (!context) { std::move(done).Run(); return; }
+  PermissionControllerImpl::FromBrowserContext(context)->ResetPermissionOverrides(std::move(done));
+}
+
+uint64_t PermissionControllerImpl::GetEmbedderContextRevision(
+    const url::Origin& requesting, const url::Origin& embedding, PermissionType type) {
+  return permission_overrides_.GetRevision(requesting, embedding, type);
+}
+std::optional<PermissionStatus> PermissionControllerImpl::GetExactEmbedderContextOverride(
+    base::optional_ref<const url::Origin> requesting,
+    base::optional_ref<const url::Origin> embedding, PermissionType type) {
+  return permission_overrides_.GetExactStatus(requesting, embedding, type);
+}
+void PermissionControllerImpl::UpdateEmbedderState(base::OnceClosure update) {
+  const auto old_statuses = GetSubscriptionsStatuses();
+  auto weak = weak_factory_.GetWeakPtr();
+  std::move(update).Run();
+  if (weak) weak->NotifyChangedSubscriptions(old_statuses);
+}
+std::optional<PermissionStatus> PermissionControllerImpl::GetEmbedderContextOverride(
+    const url::Origin& requesting, const url::Origin& embedding, PermissionType type) {
+  return permission_overrides_.GetRawStatus(requesting, embedding, type);
+}
 
