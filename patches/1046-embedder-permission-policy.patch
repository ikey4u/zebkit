+#include "third_party/blink/public/mojom/permissions/permission_status.mojom.h"
+#include "url/origin.h"
+namespace content {
+class BrowserContext;
+class RenderFrameHost;
+// UI thread only. The status hook must be side-effect free. nullopt leaves
+// the decision to Chromium. A prompt override delegates an actual request.
+using EmbedderPermissionStatusHook = base::RepeatingCallback<
+    std::optional<blink::mojom::PermissionStatus>(RenderFrameHost*, blink::PermissionType,
+                                                const url::Origin&, const url::Origin&)>;
+// A committed CDP/context override operation. Empty type means all types;
+// empty origins mean the whole context. The final argument is false before
+// mutation (for deadlines), true after it commits; both precede subscriptions.
+using EmbedderPermissionChangedHook = base::RepeatingCallback<void(
+    BrowserContext*, const std::optional<url::Origin>&,
+    const std::optional<url::Origin>&, std::optional<blink::PermissionType>, bool committed)>;
+CONTENT_EXPORT uint64_t NextEmbedderPermissionRevision();
+CONTENT_EXPORT uint64_t GetEmbedderContextPermissionRevision(
+    BrowserContext*, const url::Origin&, const url::Origin&, blink::PermissionType);
+CONTENT_EXPORT PermissionResult CreateEmbedderPermissionResult(
+    blink::PermissionType, blink::mojom::PermissionStatus, bool for_query = false);
+CONTENT_EXPORT void SetEmbedderPermissionHooks(EmbedderPermissionStatusHook status,
+                                               EmbedderPermissionChangedHook changed);
+// Snapshot subscriptions, run one embedder state mutation, then report changes.
+CONTENT_EXPORT void UpdateEmbedderPermissionState(BrowserContext*, base::OnceClosure update);
+// Raw policy decision; use CreateEmbedderPermissionResult(..., true) for query exposure.
+CONTENT_EXPORT std::optional<blink::mojom::PermissionStatus> GetEmbedderContextPermissionOverride(
+    BrowserContext*, const url::Origin&, const url::Origin&, blink::PermissionType);
+// Add grants to the exact origin/global scope, using the actual override table.
+CONTENT_EXPORT void GrantEmbedderContextPermissions(
+    BrowserContext*, const std::optional<url::Origin>& origin,
+    const std::vector<blink::PermissionType>& permissions,
+    base::OnceCallback<void(bool)> done);
+CONTENT_EXPORT void ResetEmbedderContextPermissions(BrowserContext*, base::OnceClosure done);
+}  // namespace content
+#endif
