+// Embedder permission policy, sharing Chromium's override and subscription path.
+#ifndef CONTENT_PUBLIC_BROWSER_EMBEDDER_PERMISSION_HOOKS_H_
+#define CONTENT_PUBLIC_BROWSER_EMBEDDER_PERMISSION_HOOKS_H_
+#include <cstdint>
