+struct EmbedderHooks {
+  EmbedderPermissionStatusHook status;
+  EmbedderPermissionChangedHook changed;
+};
+EmbedderHooks& PermissionHooks() {
+  static base::NoDestructor<EmbedderHooks> hooks;
+  return *hooks;
+}
+std::optional<PermissionStatus> EmbedderStatus(
+    RenderFrameHost* frame, PermissionType type,
+    const url::Origin& requesting, const url::Origin& embedding) {
+  return PermissionHooks().status
+      ? PermissionHooks().status.Run(frame, type, requesting, embedding)
+      : std::nullopt;
+}
+void EmbedderChanged(BrowserContext* context,
+                     base::optional_ref<const url::Origin> requesting,
+                     base::optional_ref<const url::Origin> embedding,
+                     std::optional<PermissionType> type, bool committed) {
+  if (PermissionHooks().changed)
+    PermissionHooks().changed.Run(context,
+        requesting ? std::make_optional(*requesting) : std::nullopt,
+        embedding ? std::make_optional(*embedding) : std::nullopt, type, committed);
+}
 
