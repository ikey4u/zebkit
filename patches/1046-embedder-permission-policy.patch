+PermissionResult CreateEmbedderPermissionResult(PermissionType type, PermissionStatus status, bool for_query) {
+  if (for_query && type == PermissionType::STORAGE_ACCESS_GRANT && status == PermissionStatus::DENIED)
+    status = PermissionStatus::ASK;
+  if ((type == PermissionType::GEOLOCATION || type == PermissionType::GEOLOCATION_APPROXIMATE) &&
+      base::FeatureList::IsEnabled(content_settings::features::kApproximateGeolocationPermission)) {
+    return PermissionResult(status, PermissionStatusSource::UNSPECIFIED,
+        GeolocationSetting{.approximate = PermissionUtil::ToPermissionOption(status),
+          .precise = PermissionUtil::ToPermissionOption(type == PermissionType::GEOLOCATION_APPROXIMATE
+                                                        ? PermissionStatus::DENIED : status)});
+  }
+  return PermissionResult(status);
+}
