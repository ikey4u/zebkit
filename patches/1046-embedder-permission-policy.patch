+      base::FeatureList::IsEnabled(content_settings::features::kApproximateGeolocationPermission)) {
+    return PermissionResult(status, PermissionStatusSource::UNSPECIFIED,
+        GeolocationSetting{.approximate = PermissionUtil::ToPermissionOption(status),
