# libzebkit as Android and iOS build it, without the engine (docs/MOBILE.md),
# for Linux x86-64: to test that configuration on the build machine
# (libzebkit.so and zebkit_mobile_test). Not a package to ship: Linux
# applications use slim, with the engine. slim-android and slim-ios start
# from this profile.
#
#   scripts/build.sh mobile-linux zebkit/engine zebkit/engine:zebkit_mobile_test

# No content layer, Blink or V8: the default on Android and iOS.
zebkit_build_engine = false

optimize_for_size = true
# Chrome's profiles are of the browser's code, not of this library's use.
chrome_pgo_phase = 0

# A library inside an application: the application's malloc, not
# PartitionAlloc put in its place.
use_partition_alloc_as_malloc = false
use_allocator_shim = false
enable_backup_ref_ptr_support = false
