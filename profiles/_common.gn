# GN arguments every profile starts from. scripts/build.sh writes this file
# and then the profile's into out/<profile>/args.gn; a profile can override
# anything set here.

target_os = "linux"
target_cpu = "x64"

# A release build as Google ships it: optimized, ThinLTO, no debug
# information, one static binary rather than hundreds of libraries.
is_debug = false
is_official_build = true
is_component_build = false
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0

# Size is measured by component from the linker's map, with Chromium's
# supersize (tools/binary_size), so no debug information is needed for it.
generate_linker_map = true

# Media playback is required, H.264 and AAC included.
proprietary_codecs = true
ffmpeg_branding = "Chrome"

# Nothing here builds remotely.
use_remoteexec = false
treat_warnings_as_errors = false

# PDFium is in the engine, for applications (<zebkit/vendor/pdfium.h>):
# without XFA forms and without PDFium's own JavaScript, which Chromium
# turns on for Chrome's viewer. A PDF's scripts are not run.
pdf_enable_xfa = false
pdf_enable_v8 = false
# PDF in pages uses Chromium's plugin (//pdf); not its ink annotations, nor
# saving to Google Drive, which its extension's interface offers.
enable_pdf_ink2 = false
enable_pdf_save_to_drive = false

# zebkit's configuration of FFmpeg: Chrome's, with what applications need
# besides (libswresample, libswscale, muxers, VP8 and VP9 decoders):
# src/ffmpeg, made by scripts/ffmpeg-config.sh, patches/1017.
zebkit_ffmpeg = true
