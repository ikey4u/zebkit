# Optional system libraries: the engine uses them when the machine has them
# and runs without them when it does not. One per line:
#
#   name  soname  pkg-config-module  default  [negative=REGEX] [zero=REGEX] [string=REGEX]
#
# "default" is what a call returns when the library or function is missing:
# zero (0/NULL) or negative (-1). The regular expressions pick functions that
# need the other value, or an empty string, to read as failure to callers.
# See tools/syslib-stubs/gen.py.

# Display: Wayland, then X11. Both report "no display" by returning NULL.
wayland-client  libwayland-client.so.0  wayland-client  zero
wayland-server  libwayland-server.so.0  wayland-server  zero
wayland-egl     libwayland-egl.so.1     wayland-egl     zero
wayland-cursor  libwayland-cursor.so.0  wayland-cursor  zero
X11             libX11.so.6             x11             zero

# GPU buffers. gbm_create_device() returns NULL; libdrm's int functions
# return 0 for success, so those report -1, while its lookups return NULL.
gbm             libgbm.so.1             gbm             zero
drm             libdrm.so.2             libdrm          negative  zero=^drm(Get(Version|LibVersion|Device|Devices|FormatModifier|FormatName|DeviceName|Bus|Stats|Cap$)|ModeGet|ModeObjectGet|Malloc|ModeAtomicAlloc|ModeCreateProperty)

# Sound. ALSA returns negative error codes; a few functions return strings.
asound          libasound.so.2          alsa            negative  string=(strerror|_name$|_get_name$|version$|_description$|_get_id$)
