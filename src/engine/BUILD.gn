# The engine as a library: libzebkit.so.1, with zebkit-helper for its child
# processes, on Linux; Zebkit.framework, with Zebkit Helper.app inside it,
# on macOS; zebkit.dll with zebkit-helper.exe on Windows. This directory is zebkit's src/engine, linked into the
# Chromium tree as //zebkit/engine by scripts/fetch-upstream.sh.

import("//build/config/ui.gni")
import("//build/config/clang/clang.gni")
import("//build/config/features.gni")
import("//build/config/ozone.gni")
import("//build/config/sysroot.gni")
import("//mojo/public/tools/bindings/mojom.gni")
import("//tools/grit/repack.gni")
import("//tools/v8_context_snapshot/v8_context_snapshot.gni")
import("//v8/gni/v8.gni")
import("//zebkit/relr/relr.gni")
if (is_mac) {
  import("//build/config/mac/mac_sdk.gni")
  import("//build/config/mac/rules.gni")
  import("//ui/gl/features.gni")
}
if (is_win) {
  import("//build/config/win/visual_studio_version.gni")
}

_version = read_file("VERSION", "trim string")

config("implementation") {
  defines = [
    "ZEBKIT_IMPLEMENTATION",
    "ZEBKIT_VERSION=\"$_version\"",
  ]
  if (is_linux && use_dbus) {
    defines += [ "ZEBKIT_COOKIES_USE_DBUS" ]
  }
  if (ozone_platform_x11) {
    defines += [ "ZEBKIT_X11" ]
  }
  if (clang_use_raw_ptr_plugin) {
    # The embedder's C handles and callback payloads follow the host's
    # lifetime contract, including pointers not owned by PartitionAlloc.
    # Keep Chromium's field-migration check out of this C API adapter;
    # Chromium's own code and its runtime pointer protections are unchanged.
    cflags = [
      "-Xclang",
      "-plugin-arg-raw-ptr-plugin",
      "-Xclang",
      "raw-ptr-exclude-path=" + rebase_path("//zebkit/engine/", root_build_dir),
    ]
  }
}

# Applications include <zebkit/zebkit.h>.
config("public") {
  include_dirs = [ "include" ]
}

# The C libraries inside the engine, for applications: each function under
# zebkit's own link name, and a header that maps the library's names to
# those (vendor/gen_vendor.py, docs/API.md, "The libraries inside the engine"). Each is linked whole, so
# that every function its headers declare is there.
_vendored = [
  "zlib",
  "zstd",
  "brotli",
  "boringssl",
  "sqlite",
  "icu",
  "harfbuzz",
  "freetype",
  "leveldb",
  "libwebp",
  "opus",
  "dav1d",
  "libvpx",
  "libjpeg",
  "libxml",
  "ffmpeg",
  "pdfium",
]

_vendored_libraries = [
  "//third_party/boringssl",
  "//third_party/brotli:dec",
  "//third_party/brotli:enc",
  "//third_party/dav1d",
  "//third_party/ffmpeg",
  "//third_party/harfbuzz",
  "//third_party/icu",
  "//third_party/libjpeg_turbo:libjpeg",
  "//third_party/libvpx",
  "//third_party/libwebp",
  "//third_party/libwebp:libwebp_demux",
  "//third_party/libwebp:libwebp_mux",
  "//third_party/leveldatabase",
  "//third_party/libxml",
  "//third_party/opus",
  "//third_party/pdfium",
  "//third_party/sqlite",
  "//third_party/zlib",
  "//third_party/zstd:compress",
  "//third_party/zstd:decompress",
]

if (is_mac) {
  _sysroot = mac_sdk_path
} else if (is_win) {
  _sysroot = visual_studio_path
} else {
  _sysroot = sysroot
}

action("vendor_sources") {
  script = "vendor/gen_vendor.py"
  inputs = [ "vendor/gen_vendor.py" ]
  deps = _vendored_libraries
  outputs = [ "$target_gen_dir/vendor/libraries.txt" ]
  foreach(library, _vendored) {
    outputs += [
      "$target_gen_dir/vendor/$library.txt",
      "$target_gen_dir/include/zebkit/vendor/$library.h",
    ]
    if (is_win) {
      outputs += [ "$target_gen_dir/vendor/$library.c" ]
    } else {
      outputs += [ "$target_gen_dir/vendor/$library.S" ]
    }
  }
  args = [
           "--target",
           current_os,
           "--src",
           rebase_path("//", root_build_dir),
           "--clang",
           rebase_path("$clang_base_path/bin/clang", root_build_dir),
           "--nm",
           rebase_path("$clang_base_path/bin/llvm-nm", root_build_dir),
           "--sysroot",
           rebase_path(_sysroot, root_build_dir),
           "--out",
           rebase_path(target_gen_dir, root_build_dir),
           "--stamp",
           rebase_path("$target_gen_dir/vendor/libraries.txt", root_build_dir),
         ] + _vendored
}

source_set("vendor") {
  # On Windows no code: the linker's export of one name for another.
  sources = filter_include(get_target_outputs(":vendor_sources"),
                           [
                             "*.S",
                             "*.c",
                           ])
  deps = [ ":vendor_sources" ]
}

# <zebkit/canvas.h> and <zebkit/text.h>: Skia and HarfBuzz, which the engine
# has anyway; a PDF hook's canvas (:pdf) is one of these.
source_set("canvas") {
  sources = [
    "canvas.cc",
    "canvas_internal.h",
    "include/zebkit/canvas.h",
    "include/zebkit/text.h",
    "text.cc",
    "text_internal.h",
  ]
  configs += [ ":implementation" ]
  public_configs = [ ":public" ]
  deps = [
    "//base",
    "//skia",
    "//third_party/harfbuzz",
  ]
}

# <zebkit/pdf.h>, with PDFium's configuration: it uses PDFium's classes
# where its public API does not reach.
source_set("pdf") {
  sources = [
    "include/zebkit/pdf.h",
    "pdf.cc",
    "pdf_appearance.cc",
    "pdf_appearance.h",
    "pdf_document.h",
    "pdf_hooks.cc",
    "pdf_hooks.h",
    "pdf_interchange.cc",
    "pdf_internal.cc",
    "pdf_internal.h",
  ]
  configs += [
    ":implementation",
    "//third_party/pdfium:pdfium_common_config",
  ]
  public_configs = [ ":public" ]
  deps = [
    ":canvas",
    "//base",
    "//third_party/boringssl",
    "//third_party/libxml",
    "//third_party/pdfium",
  ]
}

# What a page's players demux, between the renderer and the browser
# (media_capture*.cc).
mojom("media_capture_mojom") {
  sources = [ "media_capture.mojom" ]
  public_deps = [
