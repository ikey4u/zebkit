# The engine as a library: libzebkit.so.1, with zebkit-helper for its child
# processes, on Linux; Zebkit.framework, with Zebkit Helper.app inside it,
# on macOS. This directory is zebkit's src/engine, linked into the
# Chromium tree as //zebkit/engine by scripts/fetch-upstream.sh.

import("//build/config/clang/clang.gni")
import("//build/config/features.gni")
import("//build/config/sysroot.gni")
import("//mojo/public/tools/bindings/mojom.gni")
import("//tools/v8_context_snapshot/v8_context_snapshot.gni")
import("//v8/gni/v8.gni")
import("//zebkit/relr/relr.gni")
if (is_mac) {
  import("//build/config/mac/mac_sdk.gni")
  import("//build/config/mac/rules.gni")
  import("//ui/gl/features.gni")
}

_version = read_file("VERSION", "trim string")

config("implementation") {
  defines = [
    "ZEBKIT_IMPLEMENTATION",
    "ZEBKIT_VERSION=\"$_version\"",
  ]
  if (is_linux && use_dbus) {
    defines += [ "ZEBKIT_COOKIES_USE_DBUS" ]
  }
  if (clang_use_raw_ptr_plugin) {
    # The embedder's C handles and callback payloads follow the host's
    # lifetime contract, including pointers not owned by PartitionAlloc.
    # Keep Chromium's field-migration check out of this C API adapter;
    # Chromium's own code and its runtime pointer protections are unchanged.
    cflags = [
      "-Xclang",
      "-plugin-arg-raw-ptr-plugin",
      "-Xclang",
      "raw-ptr-exclude-path=" + rebase_path("//zebkit/engine/", root_build_dir),
    ]
  }
}

# Applications include <zebkit/zebkit.h>.
config("public") {
  include_dirs = [ "include" ]
}

# The C libraries inside the engine, for applications: each function under
# zebkit's own link name, and a header that maps the library's names to
# those (vendor/gen_vendor.py, docs/API.md, "The libraries inside the engine"). Each is linked whole, so
# that every function its headers declare is there.
_vendored = [
  "zlib",
  "zstd",
  "brotli",
  "boringssl",
  "sqlite",
  "icu",
  "harfbuzz",
  "libwebp",
  "opus",
  "dav1d",
  "libvpx",
  "libjpeg",
  "libxml",
  "ffmpeg",
  "pdfium",
]

_vendored_libraries = [
  "//third_party/boringssl",
  "//third_party/brotli:dec",
  "//third_party/brotli:enc",
  "//third_party/dav1d",
  "//third_party/ffmpeg",
  "//third_party/harfbuzz",
  "//third_party/icu",
  "//third_party/libjpeg_turbo:libjpeg",
  "//third_party/libvpx",
  "//third_party/libwebp",
  "//third_party/libwebp:libwebp_demux",
  "//third_party/libwebp:libwebp_mux",
  "//third_party/libxml",
  "//third_party/opus",
  "//third_party/pdfium",
  "//third_party/sqlite",
  "//third_party/zlib",
  "//third_party/zstd:compress",
  "//third_party/zstd:decompress",
]

if (is_mac) {
  _sysroot = mac_sdk_path
} else {
  _sysroot = sysroot
}

action("vendor_sources") {
  testonly = true
  script = "vendor/gen_vendor.py"
  inputs = [ "vendor/gen_vendor.py" ]
  deps = _vendored_libraries
  outputs = [ "$target_gen_dir/vendor/libraries.txt" ]
  foreach(library, _vendored) {
    outputs += [
      "$target_gen_dir/vendor/$library.S",
      "$target_gen_dir/vendor/$library.txt",
      "$target_gen_dir/include/zebkit/vendor/$library.h",
    ]
  }
  args = [
           "--target",
           current_os,
           "--src",
           rebase_path("//", root_build_dir),
           "--clang",
           rebase_path("$clang_base_path/bin/clang", root_build_dir),
           "--nm",
           rebase_path("$clang_base_path/bin/llvm-nm", root_build_dir),
           "--sysroot",
           rebase_path(_sysroot, root_build_dir),
           "--out",
           rebase_path(target_gen_dir, root_build_dir),
           "--stamp",
           rebase_path("$target_gen_dir/vendor/libraries.txt", root_build_dir),
         ] + _vendored
}

source_set("vendor") {
  testonly = true
  sources = filter_include(get_target_outputs(":vendor_sources"), [ "*.S" ])
  deps = [ ":vendor_sources" ]
}

# <zebkit/pdf.h>, with PDFium's configuration: it uses PDFium's classes
# where its public API does not reach.
source_set("pdf") {
  sources = [
    "include/zebkit/pdf.h",
    "pdf.cc",
    "pdf_internal.cc",
    "pdf_internal.h",
  ]
  configs += [
    ":implementation",
    "//third_party/pdfium:pdfium_common_config",
  ]
  public_configs = [ ":public" ]
  deps = [
    "//base",
    "//third_party/boringssl",
    "//third_party/pdfium",
  ]
}

# What a page's players demux, between the renderer and the browser
# (media_capture*.cc).
mojom("media_capture_mojom") {
  sources = [ "media_capture.mojom" ]
  public_deps = [
    "//media/mojo/mojom",
    "//mojo/public/mojom/base",
    "//ui/gfx/geometry/mojom",
  ]
}

_sources = [
  "app.cc",
  "app.h",
  "bridge.cc",
  "call.cc",
  "call.h",
  "cdp.cc",
  "chrome_object.cc",
  "client_hints.cc",
  "cookies.cc",
  "cookies.h",
  # window.chrome, by Chrome's own code (chrome_object.cc).
  "//chrome/renderer/loadtimes_bindings.cc",
  "//chrome/renderer/loadtimes_bindings.h",
  "devtools.cc",
  "dialog.cc",
  "drag.cc",
  "engine.cc",
  "engine.h",
  "include/zebkit/media.h",
  "include/zebkit/offscreen.h",
  "include/zebkit/page.h",
  "include/zebkit/services.h",
  "include/zebkit/zebkit.h",
  "media_capture.cc",
  "media_capture.h",
  "media_capture_renderer.cc",
  "media_capture_writer.cc",
  "media_capture_writer.h",
  "offscreen.cc",
  "page_internal.h",
  "pdf_bridge.cc",
  "pdf_script.h",
  "print.cc",
  "scheme.cc",
  "scheme.h",
  "script.cc",
  "services.cc",
  "ui.cc",
  "ui.h",
  "ui_script.h",
  "view.cc",
  "view.h",
]

_deps = [
  ":media_capture_mojom",
  ":pdf",
  ":vendor",
  "//base",
  "//base/version_info",
  "//components/embedder_support",
  "//components/input",
  "//components/os_crypt/async/browser",
  "//components/os_crypt/async/browser:key_provider_interface",
  "//crypto",
  "//components/version_info:version_info_with_user_agent",
  # Printing to PDF, as headless Chrome prints (print.cc).
  "//components/printing/browser",
  "//components/printing/browser/print_to_pdf",
  "//components/printing/common:mojo_interfaces",
  "//components/printing/renderer",
  "//components/resources",
  "//printing",
  "//printing/buildflags",
  "//printing/mojom",
  "//third_party/inspector_protocol:crdtp",
  "//components/viz/common",
  "//components/viz/host",
  "//media",
  "//media/capture/mojom:video_capture_buffer",
  "//mojo/public/cpp/bindings",
  "//services/viz/privileged/mojom/compositing",
  "//content/public/app",
  "//content/public/browser",
  "//content/public/common",
  "//content/public/renderer",
  "//content/shell:content_shell_app",
  "//content/shell:content_shell_lib",
  "//content/shell:pak",
  "//gin",
  "//net",
  "//net:net_resources",
  "//services/network/public/cpp",
  "//services/network/public/mojom",
  "//third_party/blink/public:blink",
  "//skia",
  "//ui/base",
  "//ui/compositor",
  "//ui/display",
  "//ui/events",
  "//ui/events:events_base",
  "//ui/gfx/codec",
  "//ui/views",
  "//ui/views/controls/webview",
  "//ui/gfx",
  "//url",
  "//v8",
]
if (is_mac) {
  _sources += [ "cookies_mac.mm" ]
} else if (is_linux && use_dbus) {
  _deps += [
    "//components/dbus",
    "//components/os_crypt/async/browser:freedesktop_secret_key_provider",
  ]
}
_deps += _vendored_libraries

declare_args() {
  # Optimize the engine across its object files as it is linked (ThinLTO
  # at -O2), as Chrome's own binary is: Blink's small functions are inlined
  # from file to file. Costs link time and some size.
  zebkit_lto_optimize = false
}

if (!is_mac) {
  _sources += [ "attach.cc" ]

  shared_library("zebkit") {
    # The content shell's browser classes, which are test-only in Chromium,
    # until zebkit has its own.
    testonly = true

    output_name = "zebkit"
    output_extension = "so.1"

    sources = _sources
    configs += [ ":implementation" ]
    if (zebkit_lto_optimize) {
      configs -= [ "//build/config/compiler:thinlto_optimize_default" ]
      configs += [ "//build/config/compiler:thinlto_optimize_max" ]
    }
    public_configs = [ ":public" ]
    deps = _deps + [ "//ui/ozone" ]

    data_deps = [
      "//content/shell:pak",
      "//tools/v8_context_snapshot",
    ]

    inputs = [ "zebkit.ver" ]
    ldflags = [
      "-Wl,--version-script=" + rebase_path("zebkit.ver", root_build_dir),
      "-Wl,-soname,libzebkit.so.1",
    ]

    if (zebkit_pack_relocations) {
      deps += [ "//zebkit/relr:relr_shared" ]
      configs += [
        "//zebkit/relr:link",
        "//zebkit/relr:link_shared",
      ]
    }
  }

  executable("zebkit-helper") {
    testonly = true
    sources = [ "helper.c" ]
    deps = [ ":zebkit" ]
    configs += [ "//build/config/gcc:rpath_for_built_shared_libraries" ]
  }

  group("engine") {
    testonly = true
    deps = [
      ":zebkit",
      ":zebkit-helper",
    ]
  }
} else {
  # Zebkit.framework/Versions/A:
  #   Zebkit                  the engine
  #   Resources/              its data files, found through the framework
  #   Helpers/Zebkit Helper.app   its renderer, GPU and utility processes
  #   Libraries/              ANGLE's and SwiftShader's libraries, where
  #                           Chromium looks for them in a framework
  # An application links the framework and finds the rest through it,
  # wherever the framework is.
  _framework_name = "Zebkit"
  _helper_name = "Zebkit Helper"

  bundle_data("zebkit_resources") {
    testonly = true
    sources = [
      "$root_out_dir/content_shell.pak",
      "$root_out_dir/icudtl.dat",
      "//ui/gl/resources/angle-metal/gpu_shader_cache.bin",
    ]
    public_deps = [
      "//content/shell:pak",
      "//third_party/icu:icudata",
    ]
    if (v8_use_external_startup_data) {
      public_deps += [ "//v8" ]
      if (use_v8_context_snapshot) {
        sources += [ "$root_out_dir/$v8_context_snapshot_filename" ]
        public_deps += [ "//tools/v8_context_snapshot" ]
      }
      if (!use_v8_context_snapshot || include_both_v8_snapshots) {
        sources += [ "$root_out_dir/snapshot_blob.bin" ]
      }
    }
    outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
  }

  # Libraries beside the engine: SwiftShader, and the Vulkan loader that
  # runs it, when the profile has it (slim-macos does not: every Mac has a
  # Metal GPU); ANGLE when it is not linked in.
  _libraries = []
  _library_deps = []
  if (enable_swiftshader) {
    _libraries += [
      "$root_out_dir/vk_intermediates/libvk_swiftshader.dylib",
      "$root_out_dir/vk_intermediates/vk_swiftshader_icd.json",
      "$root_out_dir/vulkan_intermediates/libvulkan.dylib",
    ]
    _library_deps += [
      "//ui/gl:swiftshader_vk_library_copy",
      "//ui/gl:vulkan_loader_library_copy",
    ]
  }
  if (!use_static_angle) {
    _libraries += [
      "$root_out_dir/egl_intermediates/libEGL.dylib",
      "$root_out_dir/egl_intermediates/libGLESv2.dylib",
    ]
    _library_deps += [ "//ui/gl:angle_library_copy" ]
  }
  not_needed([ "_library_deps" ])
  if (_libraries != []) {
    bundle_data("zebkit_libraries") {
      testonly = true
      sources = _libraries
      public_deps = _library_deps
      outputs = [ "{{bundle_contents_dir}}/Libraries/{{source_file_part}}" ]
    }
  }

  bundle_data("zebkit_helpers") {
    testonly = true
    sources = [ "$root_out_dir/$_helper_name.app" ]
    public_deps = [ ":zebkit_helper" ]
    outputs = [ "{{bundle_contents_dir}}/Helpers/{{source_file_part}}" ]
  }

  mac_framework_bundle("zebkit") {
    testonly = true
    output_name = _framework_name
    framework_version = "A"
    framework_contents = [
      "Helpers",
      "Libraries",
      "Resources",
    ]
    info_plist = "mac/framework-Info.plist"

    sources = _sources + [
      "engine_mac.mm",
      "offscreen_mac.h",
      "offscreen_mac.mm",
    ]
    configs += [ ":implementation" ]
    public_configs = [ ":public" ]
    deps = _deps + [
             "//sandbox/mac:seatbelt",
             "//services/device/public/cpp/geolocation",
           ]
    frameworks = [
      "AppKit.framework",
      "Foundation.framework",
      "IOSurface.framework",
    ]
    bundle_deps = [
      ":zebkit_helpers",
      ":zebkit_resources",
    ]
    if (_libraries != []) {
      bundle_deps += [ ":zebkit_libraries" ]
    }

    inputs = [ "mac/exports.txt" ]
    ldflags = [
      "-Wl,-install_name,@rpath/$_framework_name.framework/Versions/A/$_framework_name",
      "-Wl,-exported_symbols_list," + rebase_path("mac/exports.txt", root_build_dir),
    ]
  }

  # One helper for every kind of child process: the engine names it with
  # --browser-subprocess-path, so the variants a signed Chrome has for its
  # entitlements (Renderer, GPU) are not looked for.
  mac_app_bundle("zebkit_helper") {
    testonly = true
    output_name = _helper_name
    info_plist = "mac/helper-Info.plist"
    sources = [ "helper.c" ]
    deps = [ ":zebkit+link_nested" ]

    # Zebkit.framework/Versions/A/Helpers/Zebkit Helper.app/Contents/MacOS:
    # seven steps up is the directory the framework is in.
    ldflags = [ "-Wl,-rpath,@executable_path/../../../../../../.." ]
  }

  group("engine") {
    testonly = true
    deps = [ ":zebkit" ]
  }
}
