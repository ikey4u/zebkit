}

# zebkit's automation (automation*.cc, docs/AUTOMATION.md): the browser's
# calls to each frame's agent.
mojom("automation_mojom") {
  sources = [ "automation.mojom" ]
}

# A page's calls to zebkit.* (call.cc, page_call_renderer.cc): to the
# browser over the frame's channel.
mojom("page_call_mojom") {
  sources = [ "page_call.mojom" ]
  public_deps = [ "//mojo/public/mojom/base" ]
}

# The script of the agent's isolated world: Playwright's injected script and
# zebkit's steps over it, as an array.
action("automation_scripts") {
  script = "automation_scripts.py"
  inputs = [
    "automation_steps.js",
    "playwright/clock_script.js",
    "playwright/injected_script.js",
    "playwright/websocket_mock_script.js",
    "playwright/snapshotter_script.js",
    "playwright/storage_script.js",
  ]
  outputs = [ "$target_gen_dir/automation_scripts.h" ]
  args = [
    rebase_path("playwright/injected_script.js", root_build_dir),
    rebase_path("automation_steps.js", root_build_dir),
    rebase_path("playwright/clock_script.js", root_build_dir),
    rebase_path("playwright/websocket_mock_script.js", root_build_dir),
    rebase_path("playwright/snapshotter_script.js", root_build_dir),
    rebase_path("playwright/storage_script.js", root_build_dir),
    rebase_path("$target_gen_dir/automation_scripts.h", root_build_dir),
  ]
}

# The viewer of a PDF in a page, as an array.
action("pdf_viewer_script") {
  script = "pdf_viewer_script.py"
  inputs = [ "pdf_viewer.js" ]
  outputs = [ "$target_gen_dir/pdf_viewer_script.h" ]
  args = [
    rebase_path("pdf_viewer.js", root_build_dir),
    rebase_path("$target_gen_dir/pdf_viewer_script.h", root_build_dir),
  ]
}

